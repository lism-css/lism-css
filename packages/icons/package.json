{
  "name": "@lism-css/icons",
  "version": "0.1.0",
  "description": "SVG icons for React and Astro.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "packages/astro/*.astro",
    "packages/astro/index.ts",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./astro": {
      "import": "./packages/astro/index.ts"
    },
    "./astro/*": "./packages/astro/*.astro",
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "pnpm generate && pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && astro check --tsconfig packages/astro/tsconfig.json",
    "test": "pnpm build && node --test scripts/*.test.mjs",
    "lint": "eslint scripts/*.mjs src/react packages/astro src/data.ts",
    "format": "prettier --write scripts/*.mjs package.json tsconfig*.json",
    "prepack": "pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "astro": "^5 || ^6",
    "@types/react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://lism-css.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lism-css/lism-css.git",
    "directory": "packages/icons"
  },
  "devDependencies": {
    "svgo": "4.0.2",
    "typescript": "~5.9.3",
    "astro": "^6.4.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/react": "^19.2.17",
    "@types/node": "^25.9.4",
    "esbuild": "^0.28.1"
  }
}
