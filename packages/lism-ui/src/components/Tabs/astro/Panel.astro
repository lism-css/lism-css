---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    tabId?: string;
    index?: number;
    isActive?: boolean;
  };

// tabId / index は Root 側の transformTabitems が置換するため、既定値はその目印となるプレースホルダー
const { tabId = '__LISM_TAB_ID__', index = 0, isActive = false, class: className, as = 'div', ...props } = Astro.props;
const controlId = `${tabId}-${index}`;
---

<Lism
  as={as}
  id={controlId}
  role="tabpanel"
  aria-labelledby={`${controlId}-tab`}
  tabindex="0"
  hidden={!isActive}
  class={atts(className, 'b--tabs_panel')}
  {...props}><slot /></Lism
>
