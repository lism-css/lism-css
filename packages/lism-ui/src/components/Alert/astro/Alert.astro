---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { Flow, Lism, Icon } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';
import getAlertProps, { type AlertProps } from '../getProps';
import '../_style.css';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> & AlertProps;

const { class: className, ...astroProps } = Astro.props;
const { icon, layout, flow, ...alertProps } = getAlertProps(astroProps);
---

<Lism layout={layout} class={atts(className, 'b--alert')} {...alertProps}>
  <Icon icon={icon} isSide={layout === 'withSide'} />
  <Flow flow={flow}>
    <slot />
  </Flow>
</Lism>
