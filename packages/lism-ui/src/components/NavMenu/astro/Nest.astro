---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';

type Props<Tag extends HTMLTag = 'ul'> = Polymorphic<{ as: Tag }> & AstroLismBaseProps;

const { class: className, as = 'ul', ...props } = Astro.props;
---

<Lism as={as} class={atts(className, 'b--navMenu_nest')} {...props}><slot /></Lism>
