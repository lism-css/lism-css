---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';

type Props<Tag extends HTMLTag = 'span'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    id?: string;
    /** start/end は書字方向に追従する inline 軸の論理方向 */
    side?: 'top' | 'bottom' | 'start' | 'end';
    align?: 'start' | 'center' | 'end';
  };

// id の既定値はプレースホルダー。Root 配下なら Root 側で実IDに置換される（明示指定があればそれが残る）
const { class: className, id = '__LISM_TOOLTIP_ID__', side = 'top', align = 'center', ...props } = Astro.props;
---

<Lism as="span" role="tooltip" id={id} data-side={side} data-align={align} class={atts(className, 'b--tooltip_popup')} {...props}>
  <slot />
</Lism>
