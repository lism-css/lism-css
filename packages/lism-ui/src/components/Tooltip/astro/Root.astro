---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';
import uuid from '../../../helper/uuid.js';
import escapeHtmlAttr from '../../../helper/escapeHtmlAttr.js';

import '../_style.css';

type Props<Tag extends HTMLTag = 'span'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    tooltipId?: string;
    delay?: string;
  };

const { class: className, tooltipId: _tooltipId, delay, style, ...props } = Astro.props;

// aria-describedby / id 紐付け用のIDを生成（カスタム指定があればそれを使用、なければ自動生成）
const tooltipId = _tooltipId || uuid();

const mergedStyle = delay ? { ...(style as object), '--tooltip-delay': delay } : style;

// 子要素のHTMLを取得し、プレースホルダーの有無で出力方法を切り替え
// - プレースホルダーあり → 置換して set:html で出力
// - プレースホルダーなし → 通常の slot 出力（Trigger/Popup に直接IDを指定しているケース）
const rendered = await Astro.slots.render('default');
// set:html で出力するため、ユーザー指定の tooltipId は属性値としてエスケープしてから埋め込む（関数渡しで `$` パターンの解釈も防ぐ）
const slotHtml = rendered.includes('__LISM_TOOLTIP_ID__') ? rendered.replaceAll('__LISM_TOOLTIP_ID__', () => escapeHtmlAttr(tooltipId)) : null;
---

{
  slotHtml !== null ? (
    <Lism as="span" class={atts(className, 'b--tooltip')} style={mergedStyle} set:html={slotHtml} {...props} />
  ) : (
    <Lism as="span" class={atts(className, 'b--tooltip')} style={mergedStyle} {...props}>
      <slot />
    </Lism>
  )
}

<script>
  import { setTooltip } from '../setTooltip';
  setTooltip();
</script>
