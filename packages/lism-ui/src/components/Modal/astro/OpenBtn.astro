---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    modalId?: string;
  };

const { class: className, modalId = '', ...props } = Astro.props;
---

<Lism
  as="button"
  type="button"
  aria-haspopup="dialog"
  class={atts(className, 'b--modal_openBtn')}
  set="plain"
  hov="-o"
  data-modal-open={modalId}
  {...props}
>
  <slot />
</Lism>
