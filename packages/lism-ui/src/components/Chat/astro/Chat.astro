---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism, Flow, Grid, Frame, Decorator } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';
import buildModifierClass from '../../../helper/buildModifierClass';
import '../_style.css';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    /** 吹き出しスタイル */
    variant?: 'speak' | 'think';
    /** 吹き出しの方向 */
    direction?: 'start' | 'end';
    /** 発言者名 */
    name?: string;
    /** アバター画像URL */
    avatar?: string;
    /** キーカラー */
    keycolor?: string;
    /** コンテンツのフロー間隔 */
    flow?: string;
  };

const { name, avatar, flow, variant = 'speak', direction = 'start', class: className, ...props } = Astro.props;
---

<Grid class={atts(className, buildModifierClass('b--chat', { variant }))} data-chat-dir={direction} {...props}>
  {
    avatar && (
      <Frame class="b--chat_avatar" aria-hidden="true">
        <img src={avatar} alt="" width="60" height="60" decoding="async" />
      </Frame>
    )
  }
  {name && <Lism class="b--chat_name">{name}</Lism>}
  <Lism class="b--chat_body">
    <Decorator class="b--chat_deco" util="cbox" isSkipFlow />
    <Flow class="b--chat_content" util="cbox" flow={flow}>
      <slot />
    </Flow>
  </Lism>
</Grid>
