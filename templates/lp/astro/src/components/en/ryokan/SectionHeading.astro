---
/**
 * セクション見出し。英語版では日本語ラベルを非表示にし、英語見出しだけを表示する。
 * 残りの props は外側の `Stack` へ渡すため、呼び出し側で `ai` / `ta` / `ga` などを指定できる。
 */
import type { ComponentProps } from 'astro/types';
import { Heading, Stack, Text } from 'lism-css/astro';

type StackProps = ComponentProps<typeof Stack>;

type Props = StackProps & {
  en: string;
  ja: string;
  level?: '1' | '2' | '3' | '4' | '5' | '6';
};

const { en, ja, level = '2', ...rest } = Astro.props;
---

<Stack g="10" {...rest}>
  <Text class="b--enEyebrow" lang="ja" lts="l" o="pp">{ja}</Text>
  <Heading level={level} fz={['2xl', null, '3xl']} fw="500" lts="l">{en}</Heading>
</Stack>
