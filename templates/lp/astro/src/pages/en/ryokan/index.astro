/** Lism プリセットアイコン名（ https://lism-css.com/docs/primitives/a--icon/ ） */
type InformationIcon =
  'home' | 'clock' | 'cart' | 'gear' | 'book' | 'chat' | 'heart' | 'lightbulb' | 'search' | 'note' | 'bookmark' | 'user' | 'lock';

type InformationItem = {
  icon: InformationIcon;
  title: string;
  description: string;
};

const informationItems = [
  {
    icon: 'home',
    title: 'Lobby and Lounge',
    description:
      'From the moment you arrive to the quiet hours after your evening bath. Help yourself to coffee and tea sweets, and settle into the garden-side tatami seating.',
