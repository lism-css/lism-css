---

<Layout title={title} lang="en">
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400..700&display=swap" rel="stylesheet" slot="head" />
  <link
    href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&text=%E9%9D%99%E5%AF%82%E3%81%AE%E5%AE%BF&display=swap"
    rel="stylesheet"
    slot="head"
  />
  <Container class="c--page">
    <!-- Header -->
    <Header />
    <!-- Main Content。各セクションは section 自身を container にし、内側の wrapper は container にしない（--bleed の 100cqi を gutter 込みの幅で解決するため。BP の基準もセクション幅） -->
    <Container as="main" class="c--main" pos="relative" z="0">
      <Container
        as="section"
        class="c--hero"
        pos="relative"
        ov="clip"
        bgc="base"
        min-h="100svh"
        style={{
          '--c--ryokan-mv-bgCycleDuration': `${mvBgCycleDuration}s`,
          '--c--ryokan-mv-lineBlurMax': `${mvLineRevealBlurPx}px`,
          '--c--ryokan-mv-lineDuration': `${mvLineRevealDuration}s`,
          '--c--ryokan-mv-lineStartDelay': `${mvLineRevealStartDelay}s`,
          '--c--ryokan-mv-lineStagger': `${mvLineRevealStagger}s`,
        }}
      >
        <Frame isLayer>
          {
            mvImages.map((src, index) => (
              <Layer
                class="c--hero_layer"
                style={{
                  '--c--ryokan-mv-layerBgImage': `url('${src}')`,
                  '--c--ryokan-mv-layerDelay': `${index * mvDurationPerImage - mvBgCycleDuration}s`,
                }}
              />
            ))
          }
        </Frame>
        <Layer bgc="black:30%" aria-hidden="true" />
        <Stack
          pos="relative"
          z="1"
          ai="center"
          jc="center"
          px={['20', null, '40']}
          pbs="calc(var(--header-h--init) + var(--s30))"
          pbe="40"
          min-h="100svh"
        >
          <Text class="c--hero_copy">
            {
              mvCopyLines.map((line, i) => (
                <Inline class="c--hero_line" style={{ '--c--ryokan-mv-lineIndex': i }}>
                  {line}
                </Inline>
              ))
            }
          </Text>
        </Stack>
      </Container>
      <!-- MV の動的 @keyframes はマージで抽出されないため、set:html で明示注入 -->
      <style set:html={mvLayeredKeyframesStyle}></style>

      <Container as="section" id="about" class="c--about" set="bleed" contentSize="l" py="60">
        <Grid gtc={['1fr', null, 'minmax(0, 1fr) minmax(0, 50%)']} g={['30', null, '0']} ai={['start', null, 'stretch']}>
          <Stack g={['40', null, null, '50']} h={['auto', null, '100%']}>
            <Stack g={['40', null, null, '50']} ps="var(--bleed)" pe={['var(--gutter--base)', null, '40', '50']}>
              <SectionHeading en="About us" ja="当宿について" ai="start" />
              <Text hl="l" c="text-2" ps={[null, null, null, '40']}>
                {aboutBodyCopy}
              </Text>
            </Stack>
            <Frame as="figure" set="bleed" contentSize="xl" ar="4/3" w="min(20rem, 100%)" ms="var(--bleed)" pbs="15" d={['none', null, 'block']}>
              <Media src={aboutImgLeft.src} alt={aboutImgLeft.alt} width={aboutImgLeft.width} height={aboutImgLeft.height} loading="lazy" />
            </Frame>
          </Stack>
          <!-- md 以上は行の高さいっぱいに敷くため aspect-ratio を外す -->
          <Frame as="figure" ar={['4/3', null, 'auto']} h={['auto', null, '100%']} min-h="0" pbe={['0', null, '50']}>
            <Media src={aboutImgRight.src} alt={aboutImgRight.alt} width={aboutImgRight.width} height={aboutImgRight.height} loading="lazy" />
          </Frame>
        </Grid>
      </Container>

      <Lism as="section" id="feature" class="c--feature" isContainer set="light" pos="relative" bgc="base" c="text" py="60">
        <Lism isWrapper="l" hasGutter set="bleed" pos="relative">
          <Grid gtc={['1fr', null, 'minmax(0, 1.05fr) minmax(0, 1fr)']} g={['40', null, null, '50']}>
            <Frame
              as="figure"
              class="c--feature_figure"
              pos="relative"
              aslf="stretch"
              order={[1, null, 0]}
              ar={['3/2', null, 'auto']}
              ms={[null, null, 'calc(-1 * var(--bleed))']}
              w={[null, null, 'calc(100% + var(--bleed))']}
              bdrs={['10', null, '0 var(--bdrs--10) var(--bdrs--10) 0']}
            >
              <Media
                src={featureImg.src}
                alt={featureImg.alt}
                width={featureImg.width}
                height={featureImg.height}
                loading="lazy"
                min-h={[null, null, 'min(22rem, 52vw, 540px)']}
              />
            </Frame>
            <Stack class="c--feature_textCol" pos="relative" min-h="0" h="100%">
              <Lism as="span" class="c--feature_watermark" aria-hidden="true">Experience</Lism>
              <!-- lg 以上は2列 grid: 見出しは右列上端、本文は左列下端 -->
              <Grid
                class="c--feature_copyRow"
                gtc={[null, null, null, '1fr auto']}
                gtr={[null, null, null, '1fr auto']}
                g={['50', null, '40']}
                min-h={['0', null, null, 'min(22rem, 52vw)']}
                pos="relative"
                fx="1"
              >
                <Heading
                  level="2"
                  class="c--feature_title"
                  fz={['2xl', null, '3xl']}
                  fw="600"
                  lts="l"
                  lh="1.65"
                  aslf="start"
                  gc={[null, null, null, 2]}
                  gr={[null, null, null, '1/-1']}
                >
                  <Flex class="c--feature_titleInner" fxd={['column', null, null, 'row-reverse']} ai="start" g={['0', null, null, '20']} lts="l">
                    <Inline class="c--feature_titleLine1" d="block" wm={[null, null, null, 'vertical-rl']}>A Special Journey,</Inline>
                    <Inline class="c--feature_titleLine2" d="block" wm={[null, null, null, 'vertical-rl']}>an Experience of Silence</Inline>
                  </Flex>
                </Heading>
                <Stack
                  g={['20', null, null, '30']}
                  ai="start"
                  gc={[null, null, null, 1]}
                  gr={[null, null, null, 2]}
                  max-w={[null, null, null, 'min(100%, 26rem)']}
                >
                  <Text class="c--feature_lead" fz={['l', null, 'xl']} fw="600" lts="l">
                    {featureLead}
                  </Text>
                  <Text class="c--feature_body" fz="m" hl="l">
                    {featureBody}
                  </Text>
                </Stack>
              </Grid>
            </Stack>
          </Grid>
        </Lism>
      </Lism>

      <Lism as="section" id="feature2" class="c--season" isContainer pos="relative" ov-x="clip">
        <Frame isLayer>
          <Media src={seasonBg.src} alt="" width={seasonBg.width} height={seasonBg.height} loading="lazy" aria-hidden="true" />
        </Frame>
        <Layer bgc="black:75%" style={{ backdropFilter: 'blur(6px)' }} aria-hidden="true" />
        <Lism isWrapper="l" hasGutter pos="relative" z="1" pt="60">
          <Grid gtc={['1fr', null, 'min-content 1fr']} g={['40', null, '30', '50']} ai="start">
            <Stack isSide g="25">
              <Heading level="2" fz={['3xl', null, null, '4xl']} lts="l" hl="l">
                <span class="-whs:nowrap">Feel the changing</span> seasons.
              </Heading>
              <Inline lang="ja" o="pp" lts="l">季節の移ろいを、肌で感じる。</Inline>
            </Stack>
            <Text hl="xl" o="mp">
              {seasonIntroBody}
            </Text>
          </Grid>
        </Lism>
        <Lism isWrapper="xl" hasGutter pos="relative" z="1" pb="60">
          <Columns cols={[2, null, 4]} mbs="50" g={['20', null, '40']} ai="start">
            {
              seasonGalleryPhotos.map(({ src, alt }, i) => (
                <Frame as="figure" ar="4/3" pos="relative" mbs={i === 1 || i === 3 ? ['0', null, '40'] : '0'}>
                  <Media src={src} alt={alt} width={800} height={600} loading="lazy" />
                </Frame>
              ))
            }
          </Columns>
        </Lism>
      </Lism>

      <Lism as="section" id="plans" class="c--plans" isContainer py="60">
        <Lism isWrapper="l" hasGutter>
          <Stack g="50">
            <SectionHeading en="Plans" ja="宿泊プラン" ai="center" ta="center" />

            <Stack g="50">
              {
                plans.map((plan) => (
                  <Flex fxd={['column', null, 'row-reverse']} g={['30', null, '50']}>
                    <Frame as="figure" ar="16/10" bdrs="10" w="100%" max-w={['100%', null, 'min(32rem, 40cqi)']}>
                      <Media src={plan.image.src} alt={plan.image.alt} width={plan.image.width} height={plan.image.height} loading="lazy" />
                    </Frame>

                    <Stack g="30" fx="1" min-h="0" jc="between">
                      <Stack g="30">
                        <Heading level="3" fz={['l', null, 'xl']} fw="500" lts="l">
                          {plan.title}
                        </Heading>
                        <Text fz="s" hl="l" c="text-2">
                          {plan.description}
                        </Text>
                      </Stack>

                      <Stack g="30" fxsh="0">
                        <Columns cols="3" bd bdc="divider" bdrs="20" ov="hidden" bgc="base-2">
                          {plan.stats.map((stat, index) => (
                            <Stack g="10" p="20" py="25" ai="center" hl="s" ta="center" bdc="divider" class:list={[{ '-bd-s': index > 0 }]}>
                              <Text fz="xs" c="text-2" o="p">
                                {stat.label}
                              </Text>
                              <Text fw="bold" lts="l">
                                {stat.value}
                              </Text>
                            </Stack>
                          ))}
                        </Columns>

                        {/* ボタン自身の幅を基準に fxd / ai を切り替えるためのクエリコンテナ */}
                        <Box isContainer>
                          <Button
                            href="#reservation"
                            layout="flex"
                            w="100%"
                            fxd={['column', 'row']}
                            jc="center"
                            ai={['center', null, 'end']}
                            g="10"
                            bgc="text"
                            c="base"
                            bdrs="10"
                            py="15"
                            px="20"
                            ta="center"
                          >
                            <Inline fw="500" lts="l">
                              Book this plan
                            </Inline>
                          </Button>
                        </Box>
                      </Stack>
                    </Stack>
                  </Flex>
                ))
              }
            </Stack>
          </Stack>
        </Lism>
      </Lism>

      <Lism as="section" id="information" class="c--information" isContainer pos="relative" bgc="base-2" py="60" ov="hidden">
        <Lism isWrapper="l" hasGutter pos="relative" z="1">
          <Stack g="50">
            <Flex fxd={['column', null, 'row']} g={['30', null, '50']} ai={['start', null, 'end']} fxw="wrap">
              <SectionHeading en="Facilities" ja="館内設備" ai="start" fxsh="0" />
              <Text fz="s" hl="l" c="text-2" max-sz="s">
                {informationIntro}
              </Text>
            </Flex>

            <Columns cols={[1, null, 2]} g="30">
              {
                informationItems.map((item) => (
                  <Flex ai="center" bd bdrs="20" bdc="divider" ov="hidden" p={['20', null, '30']} bgc="base">
                    <Flex g={['20', null, '30']} ai="center">
                      <Icon icon={item.icon} size="2.5em" c="text-2" />
                      <Stack g="10" fx="1">
                        <Heading level="3" fz={['m', null, 'l']} fw="500" lts="l">
                          {item.title}
                        </Heading>
                        <Text fz="s" c="text-2">
                          {item.description}
                        </Text>
                      </Stack>
                    </Flex>
                  </Flex>
                ))
              }
            </Columns>
          </Stack>
        </Lism>
      </Lism>

      <Lism as="section" id="faq" class="c--faq" isContainer set="light" bgc="base" c="text" py="60">
        <Lism isWrapper="l" hasGutter>
          <Columns cols={[1, null, 2]} gta={["'head' 'acc' 'img'", null, "'head head' 'img acc'"]} g={['40', null, null, '50']}>
            <SectionHeading en="FAQ" ja="よくあるご質問" ga="head" ai="center" ta="center" />

            <Frame as="figure" ga="img" ar={['16/10', null, '1/1']} bdrs="10">
              <Media src={faqImage.src} alt={faqImage.alt} width={faqImage.width} height={faqImage.height} loading="lazy" />
            </Frame>

            <Accordion.Root layout="stack" ga="acc" bd-b>
              {
                faqItems.map((item) => (
                  <Accordion.Item isOpen={item.defaultOpen === true} bd-t>
                    <Accordion.Heading>
                      <Accordion.Button g="15" py="20" isOpen={item.defaultOpen === true}>
                        {item.question}
                      </Accordion.Button>
                    </Accordion.Heading>
                    <Accordion.Panel py="0" pb="20" isOpen={item.defaultOpen === true}>
                      <Text fz="s" c="text-2" hl="l">
                        {item.answer}
                      </Text>
                    </Accordion.Panel>
                  </Accordion.Item>
                ))
              }
            </Accordion.Root>
          </Columns>
        </Lism>
      </Lism>

      <Lism as="section" id="reservation" class="c--reservation" isContainer pos="relative" py="60" ov="hidden">
        <Frame isLayer>
          <Media src={reservationBg.src} alt="" width={reservationBg.width} height={reservationBg.height} loading="lazy" />
        </Frame>
        <Layer bgc="black:50%" style={{ backdropFilter: 'blur(6px)' }} aria-hidden="true" />

        <Lism isWrapper="l" hasGutter pos="relative" z="1">
          <Grid gtc={['1fr', null, 'minmax(0, 0.6fr) minmax(0, 1fr)']} g={['40', null, '50']}>
            <Stack g="30" ai="start">
              <SectionHeading en="Reservation" ja="ご予約はこちら" ai="start" />
              <Text fz="s" c="text-2">
                Book through whichever reservation site you prefer. Once your booking is complete, a confirmation email will arrive from that site.
                For cancellations and changes, please follow the instructions given by the site you used.
              </Text>
            </Stack>

            <Stack g="40">
              {
                reservationSites.map((site) => (
                  <Lism pos="relative" bgc="text" c="base" bdrs="20" ov="hidden">
                    <Flex fxd={['column', null, 'row']}>
                      <Frame as="figure" ar="16/10" bdrs="0" w={['100%', null, '12rem']} fxsh="0">
                        <Media src={site.image.src} alt={site.image.alt} width={site.image.width} height={site.image.height} loading="lazy" />
                      </Frame>
                      <Stack g="15" min-h="0" fx="1" px={['20', null, '30']} py={['20', null, '30']} ov="auto">
                        <Heading level="3" fz="l" fw="600">
                          {site.title}
                        </Heading>
                        <Text fz="s" o="mp">
                          {site.body}
                        </Text>
                        <Button href={site.href} bgc="base" c="text" bdrs="20" py="15" px="20" fz="s" fw="500" ta="center">
                          Go to the site
                        </Button>
                      </Stack>
                    </Flex>
                  </Lism>
                ))
              }
            </Stack>
          </Grid>
        </Lism>
      </Lism>
    </Container>
    <!-- Footer -->
    <Lism as="footer" id="footer" class="c--footer" isContainer py={['50', null, '60']}>
      <Lism isWrapper="xl" hasGutter>
        <Stack g={['40', null, '50']}>
          <Cluster ai="end" g={['15', null, '40']}>
            <Heading lang="ja" level="2" fz={['2xl', null, '3xl']} fw="normal" lts="l" hl="l" ff="accent">
              {logoLabel}
            </Heading>
            <Text fz={['s', null, 'm']} c="text-2">Away from the city's noise, in the calm of nature, a moment of pure bliss.</Text>
          </Cluster>

          <Flex fxd={['column', null, 'row']} ai="end" jc="between" g={['30', null, '40']}>
            <Flex as="ul" class="c--footer_nav" fxd={['column', null, 'row']} fxw="wrap" w={['100%', null, 'auto']} fx="1">
              {
                footerNavItems.map(({ href, ja, en }) => (
                  <ListItem>
                    <BoxLink
                      href={href}
                      layout="grid"
                      gtc={['1fr auto', null, '1fr']}
                      ji={['start', null, 'center']}
                      ai="center"
                      fz="m"
                      td="none"
                      py={['15', null, '0']}
                      px={['5', null, '10']}
                      c="inherit"
                      hov="-o"
                    >
                      <Stack class="c--footer_navStack" g="5">
                        <Inline>{en}</Inline>
                        <Inline lang="ja" fz="s" o="pp">
                          {ja}
                        </Inline>
                      </Stack>
                      {/* Icon の `d` prop は SVG の `d` 属性と型が衝突するため、表示切替は Box で包んで指定する */}
                      <Box d={['block', null, 'none']}>
                        <Icon icon="caret-right" fz="s" o="pp" />
                      </Box>
                    </BoxLink>
                  </ListItem>
                ))
              }
            </Flex>

            <Cluster g="20" jc={['center', null, 'end']} ai="end" w={['100%', null, 'auto']}>
              {
                footerSnsLinks.map(({ href, icon, label }) => (
                  <Link href={href} td="none" c="inherit" o="pp" hov={{ o: 1 }} hasTransition aria-label={label}>
                    <Icon icon={icon} fz="xl" />
                  </Link>
                ))
              }
            </Cluster>
          </Flex>

          <Text fz="xs" o="pp" ta="center">© 2026 Lism CSS.</Text>
        </Stack>
      </Lism>
    </Lism>

    <Lism pos="fixed" z="99" r="max(var(--s35), env(safe-area-inset-right))" b="max(var(--s35), env(safe-area-inset-bottom))" w="fit">
      <Button
        class="c--reservationFab"
        href="#reservation"
        layout="center"
        g="10"
        py="1em"
        px="1.5em"
        lts="l"
        bdrs="10"
        bd
        bdc="divider"
        bgc="base"
        c="text"
        bxsh="20"
        hov="-bgc"
        fz={['xs', null, 's']}
      >
        <Inline fw="500">Book Your Stay</Inline>
      </Button>
    </Lism>
  </Container>
</Layout>
