    body: 'Perk: an early-booking discount campaign is running now. Choose your dates from the availability calendar.',
    href: '#',
    image: {
      src: 'https://cdn.lism-css.com/img/japan/a_77prliRsZS.jpg',
      alt: 'Promotional photo for Travel Trip',
