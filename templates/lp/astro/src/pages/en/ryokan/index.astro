---
import Layout from '@/layouts/Layout.astro';
import {
  Box,
  BoxLink,
  Cluster,
  Columns,
  Container,
  Flex,
  Frame,
  Grid,
  Heading,
  Icon,
  Inline,
  Layer,
  Link,
  Lism,
  ListItem,
  Media,
  Stack,
  Text,
} from 'lism-css/astro';
import { Accordion } from '@lism-css/ui/astro/Accordion';
import { Button } from '@lism-css/ui/astro/Button';
import Header from '@/components/en/ryokan/Header.astro';
import SectionHeading from '@/components/en/ryokan/SectionHeading.astro';
import './_style.css';

export const title = '静寂の宿';

const logoLabel = title;

const mvImages = ['https://cdn.lism-css.com/img/japan/u-Dczv0Klww4.jpg', 'https://cdn.lism-css.com/img/japan/a_JNaB1eSLPA.jpg'];
const mvCopyLines = ["Away from the city's noise,", 'in the calm of nature,', 'a moment of pure bliss.'];

const mvDurationPerImage = 7;
const mvFadeTime = 3;
const mvLineRevealStartDelay = 0.55;
const mvLineRevealStagger = 0.72;
const mvLineRevealDuration = 1.55;
const mvLineRevealBlurPx = 14;
const mvBgImageScaleMax = 1.05;

const mvBgCycleDuration = mvDurationPerImage * mvImages.length;
const mvHoldPercent = ((mvDurationPerImage - mvFadeTime) / mvBgCycleDuration) * 100;
const mvFadeOutPercent = (mvDurationPerImage / mvBgCycleDuration) * 100;
const mvHiddenPercent = ((mvBgCycleDuration - mvFadeTime) / mvBgCycleDuration) * 100;

/** フェードイン終端（100%/0% 接続）までに進む scale。フェードイン区間でも拡大が継続する */
const mvBgScaleGrowthSpan = 100 - mvHiddenPercent + mvHoldPercent;
const mvBgScaleJoin = mvBgScaleGrowthSpan > 0 ? 1 + ((100 - mvHiddenPercent) / mvBgScaleGrowthSpan) * (mvBgImageScaleMax - 1) : mvBgImageScaleMax;
const mvBgScaleJoinCss = mvBgScaleJoin.toFixed(6);
const mvBgScaleMaxCss = Number(mvBgImageScaleMax).toFixed(6);

/** 背景クロスフェード + scale（非表示→フェードイン→ホールド終端まで 1→mvBgImageScaleMax） */
const mvLayeredKeyframesStyle = `@layer lism-custom {
  @keyframes ryokan-mv-bgFade {
    0% {
      opacity: 1;
      transform: scale(${mvBgScaleJoinCss});
    }
    ${mvHoldPercent}% {
      opacity: 1;
      transform: scale(${mvBgScaleMaxCss});
    }
    ${mvFadeOutPercent}% {
      opacity: 0;
      transform: scale(${mvBgScaleMaxCss});
    }
    ${mvHiddenPercent}% {
      opacity: 0;
      transform: scale(1);
    }
    100% {
      opacity: 1;
      transform: scale(${mvBgScaleJoinCss});
    }
  }
}`;

const aboutImgLeft = {
  src: 'https://cdn.lism-css.com/img/japan/u-qQGCFQFlkT.jpg',
  alt: 'Koi swimming in the garden pond',
  width: 1920,
  height: 1280,
};
const aboutImgRight = {
  src: 'https://cdn.lism-css.com/img/japan/u-lCzkkcbJUb.jpg',
  alt: 'An autumn garden seen from the tatami room',
  width: 1600,
  height: 1200,
};

const aboutBodyCopy =
  'A stately presence shaped by more than a century of history. We welcome you into a space where the quiet charm of old Japan meets the comforts of today. Gaze out over a meticulously tended Japanese garden, wrapped in silence, as the hot spring waters offer a rare kind of healing. With a spirit of hospitality handed down through generations, we bring color to a journey unlike any other. In the garden, where the seasons turn, each day wears a different face: the scent of new leaves, the shade of deep summer green, the blazing beauty of autumn maples, the hushed elegance of fresh snow. The setting, the tableware, the kaiseki, the bath, and a hospitality that speaks softly. In every one of these, we hope to weave a moment that lingers long in your memory. Leave the city behind, and here at our quiet hidden retreat, let yourself unwind into pure bliss.';

const featureImg = {
  src: 'https://cdn.lism-css.com/img/japan/u-L4YLmcBryx.jpg',
  alt: 'A path lined with rows of vermilion torii gates',
  width: 1920,
  height: 1280,
};

const featureLead = 'Cherry blossoms in spring, maple leaves in autumn.';
const featureBody =
  'Framing the most beautiful moment of every passing season, our ryokan sits in harmony with nature like a single painted scroll. Enjoy the celebrated waters and the flavors of the moment with the people who matter most. In spring, pale petals drifting past the window; in summer, deep green and the sound of wind chimes; in autumn, blazing maples under a clear sky; in winter, a quiet blanket of snow and rising steam from the bath.';

const seasonBg = {
  src: 'https://cdn.lism-css.com/img/japan/u-MES3nTNrVq.jpg',
  width: 1920,
  height: 1080,
};

const seasonGalleryPhotos = [
  { src: 'https://cdn.lism-css.com/img/japan/u-1.jpg', alt: 'Mount Fuji at sunrise' },
  { src: 'https://cdn.lism-css.com/img/japan/u-Dczv0Klww4.jpg', alt: 'Japanese mountain ridges above a sea of clouds' },
  { src: 'https://cdn.lism-css.com/img/japan/u-xJdqvxp0ak.jpg', alt: 'Evening light on the lakeshore' },
  { src: 'https://cdn.lism-css.com/img/japan/u-LGjnEWb619.jpg', alt: 'Snow-covered peaks' },
] as const;

const seasonIntroBody =
  'At a hidden retreat wrapped in silence, savor the changing seasons with all five senses. Sink into the open-air bath and let the rustle of trees, birdsong, and shifting colors of the sky ease your mind. In a space where traditional beauty meets modern comfort, enjoy precious time with someone special. In spring, stone paths glisten with rain; in summer, fireflies shimmer across the pond. From the terrace beneath the autumn moon, distant town lights shine like scattered gold in the clear air. When winter snow blankets the garden, a warm cup by the hearth gently soothes the weariness of travel. Enjoy the aroma of carefully selected tea in the tearoom, or choose a book in the reading corner before setting out. We hope seasonal dishes made with local ingredients and the lovingly tended garden remain vivid in your memory. Beyond the hot-spring mist, carry home renewed energy and new connections with people and nature.';

type PlanStat = {
  label: string;
  value: string;
};

type Plan = {
  title: string;
  description: string;
  stats: readonly [PlanStat, PlanStat, PlanStat];
  image: {
    src: string;
    alt: string;
    width: number;
    height: number;
  };
};

const plans = [
  {
    title: 'Unhurried Stay with Dinner, Breakfast and Open-Air Bath',
    description:
      'A seasonal kaiseki dinner, a morning tray, and an open-air bath that keeps the warmth in: one unbroken stretch of time. Dine at your own pace in your room, and between soaks, linger over the garden. Extra drink orders and allergy accommodations are also possible, so please let us know when you book.',
    stats: [
      { label: 'Guests', value: '1–2 guests' },
      { label: 'Rate', value: 'From ¥29,800' },
      { label: 'Room type', value: 'Japanese-style room with open-air bath' },
