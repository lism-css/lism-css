      { label: 'Guests', value: '1–3 guests' },
      { label: 'Rate', value: 'From ¥18,500' },
      { label: 'Room type', value: '10-mat Japanese room with veranda' },
    ],
    image: {
      src: 'https://cdn.lism-css.com/img/japan/u-qQGCFQFlkT.jpg',
      alt: 'Koi swimming in the garden pond',
      width: 1920,
      height: 1280,
    },
  },
  {
    title: 'Multi-Night Value Plan: Nothing but Hot Springs',
    description:
      'A trip to soak fully in famed waters and deep quiet, at a friendly multi-night rate. Meals are our simple signature trays, with a post-bath sweet delivered right to your room.',
    stats: [
      { label: 'Guests', value: '2 guests or more' },
      { label: 'Rate', value: 'From ¥52,000 / 2 nights' },
      { label: 'Room type', value: 'Japanese-Western twin room' },
