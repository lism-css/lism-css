    icon: 'book',
    title: 'Reading Room and Study Corner',
    description: 'Guidebooks and photo collections on ryokan and hot-spring towns. Turn a few pages after your bath and plan tomorrow at leisure.',
  },
] as const satisfies readonly InformationItem[];

const informationIntro =
  'From a traditional cure to a longer, slower stay, our facilities let you set the rhythm of your trip. Short paths from the baths to the guest rooms, and guidance designed with late-night use in mind.';

/** 各項目は質問・回答を独立して管理（必要に応じて初期展開を指定） */
const faqItems: { question: string; answer: string; defaultOpen?: boolean }[] = [
  {
    question: 'This is my first stay at a ryokan. Is it complicated?',
    answer:
      'Not at all. First-time guests find everything easy to follow. If anything is unclear, the front desk is glad to answer your questions, so please relax and enjoy your stay.',
    defaultOpen: true,
  },
  {
