---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Stack, AutoColumns, Box } from 'lism-css/astro';
import PatternCard from '@/components/patterns/PatternCard.astro';
import SectionHeader from '@parts/SectionHeader.astro';
import PageHeader from '@parts/PageHeader.astro';
import { layoutDemos, categoryIds, type LayoutDemoCategoryId } from '@/config/layout-demos';
import { filterDraftItems } from '@/lib/layout-demos';

const title = 'Layout Demos';
const description = 'ページやセクションの骨格レベルのレイアウトデモ集。Lism CSS のレイアウトプリミティブを使った構造の組み方を紹介します。';
---

<BaseLayout title={title} description={description} excludeFromSearch>
  <Stack g="40">
    <PageHeader title={title} description={description} />

    <Stack g="40">
      {
        categoryIds.map((categoryId: LayoutDemoCategoryId) => {
          const category = layoutDemos[categoryId];
          const items = filterDraftItems(category.items);
          if (items.length === 0) return null;
          return (
            <Box as="section">
              <SectionHeader title={category.label} count={items.length} />

              <AutoColumns cols="24rem" g="20" mbs="20">
                {items.map((item) => (
                  <PatternCard
                    href={`/docs/layout-demos/${categoryId}/${item.id}`}
                    thumbSrc={`/screenshots/layout-demos/${categoryId}/${item.id}.png`}
                    title={item.title}
                    draft={item.draft}
                  />
                ))}
              </AutoColumns>
            </Box>
          );
        })
      }
    </Stack>
  </Stack>
</BaseLayout>
