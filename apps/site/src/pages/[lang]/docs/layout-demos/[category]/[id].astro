---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Flow, Text, Group, Cluster, Link } from 'lism-css/astro';
import { PreviewFrame } from '@/components/Preview';
import PageHeader from '@parts/PageHeader.astro';
import { layoutDemos, type LayoutDemoCategoryId } from '@/config/layout-demos';
import { getAllLayoutDemoPaths, getLayoutDemo } from '@/lib/layout-demos';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  const demoPaths = getAllLayoutDemoPaths();

  const paths = [];
  for (const lang of nonRootLangs) {
    for (const { category, id } of demoPaths) {
      paths.push({
        params: { lang, category, id },
        props: { lang },
      });
    }
  }
  return paths;
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;
const { category, id } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const demo = getLayoutDemo(category!, id!);

if (!demo) {
  return Astro.redirect('/404');
}

const categoryData = layoutDemos[category as LayoutDemoCategoryId];

// preview に en.astro は無いため共通の index.astro を参照する
const previewUrl = `/preview/layout-demos/${category}/${id}/`;
const demoPath = `src/pages/preview/layout-demos/${category}/${id}`;
---

<BaseLayout title={`${demo.title} - Layout Demos`} description={demo.description[lang]} lang={lang} excludeFromSearch noindex>
  <Flow g="30">
    <PageHeader
      title={demo.title}
      description={demo.description[lang]}
      draft={demo.draft}
      backHref={`/${lang}/docs/layout-demos/`}
      backLabel="Back to Layout Demos"
    >
      <Text slot="eyebrow" tt="uppercase" lts="l">
        {categoryData.label}
      </Text>
      {
        demo.related && (
          <Cluster g="15" fz="xs">
            {demo.related.map((related) => (
              <Link href={`/${lang}${related.path}`}>{related.label}</Link>
            ))}
          </Cluster>
        )
      }
    </PageHeader>
    <Group layout="flow" mbs="50">
      <PreviewFrame url={previewUrl} hasSizeSwitch files={[{ path: `${demoPath}/index.astro`, title: 'index.astro' }]} />
    </Group>
  </Flow>
</BaseLayout>
