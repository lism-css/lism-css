{
  "name": "lism-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:mdx": "tsx scripts/format-mdx-codeblocks.ts",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit && astro check --tsconfig ./tsconfig.json",
    "generate:lastmod": "tsx scripts/generate-lastmod-map.ts",
    "screenshot:patterns:new": "pnpm build:astro && npx tsx scripts/generate-screenshots.ts",
    "screenshot:patterns:force": "pnpm build:astro && npx tsx scripts/generate-screenshots.ts --force",
    "screenshot:patterns:compare": "pnpm build:astro && npx tsx scripts/compare-screenshots.ts",
    "screenshot:patterns:update": "npx tsx scripts/update-screenshots.ts",
    "screenshot:templates": "npx tsx scripts/template-screenshots.ts",
    "screenshot:templates:force": "npx tsx scripts/template-screenshots.ts --force",
    "screenshot:templates:compare": "npx tsx scripts/template-screenshots.ts --compare",
    "screenshot:templates:update": "npx tsx scripts/template-screenshots.ts --update --no-build",
    "screenshot:page-layouts": "pnpm build:astro && npx tsx scripts/page-layout-screenshots.ts",
    "screenshot:page-layouts:force": "pnpm build:astro && npx tsx scripts/page-layout-screenshots.ts --force",
    "lint": "astro sync && pnpm lint:eslint",
    "lint:eslint": "eslint '**/*.{js,mjs,ts,tsx,astro,mdx}'",
    "test": "vitest run && pnpm run typecheck"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@lism-css/plugin": "workspace:*",
    "@lism-css/ui": "workspace:*",
    "@pagefind/default-ui": "^1.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "astro": "^6.4.8",
    "astro-expressive-code": "^0.44.1",
    "lism-css": "workspace:*",
    "lucide-react": "^0.577.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-external-links": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "satori": "^0.18.4",
    "sharp": "^0.35.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "mdast-util-directive": "^3.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
