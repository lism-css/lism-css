  allowfullscreen></iframe>

<h3>object</h3>
<object data="/sample.pdf" type="application/pdf" width="800" height="800">
  <p><b>表示されない時の表示</b>: <a href="pdf.pdf">PDF をダウンロード</a>.</p>
</object>
