---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Flow, Text, Group, Cluster, Link } from 'lism-css/astro';
import { PreviewFrame } from '@/components/Preview';
import PageHeader from '@parts/PageHeader.astro';
import { pageLayouts, type PageLayoutCategoryId } from '@/config/page-layouts';
import { getAllPageLayoutPaths, getPageLayout } from '@/lib/page-layouts';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  const layoutPaths = getAllPageLayoutPaths();

  const paths = [];
  for (const lang of nonRootLangs) {
    for (const { category, id } of layoutPaths) {
      paths.push({
        params: { lang, category, id },
        props: { lang },
      });
    }
  }
  return paths;
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;
const { category, id } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const layout = getPageLayout(category!, id!);

if (!layout) {
  return Astro.redirect('/404');
}

const categoryData = pageLayouts[category as PageLayoutCategoryId];

// preview に en.astro は無いため共通の index.astro を参照する
const previewUrl = `/preview/page-layouts/${category}/${id}/`;
const layoutPath = `src/pages/preview/page-layouts/${category}/${id}`;
---

<BaseLayout title={`${layout.title} - Page Layouts`} description={layout.description[lang]} lang={lang} excludeFromSearch noindex>
  <Flow g="30" class="c--pageLayoutPage">
    <PageHeader
      title={layout.title}
      description={layout.description[lang]}
      draft={layout.draft}
      backHref={`/${lang}/page-layouts/`}
      backLabel="Back to Page Layouts"
    >
      <Text slot="eyebrow" tt="uppercase" lts="l">
        {categoryData.label}
      </Text>
      {
        layout.related && (
          <Cluster g="15" fz="xs">
            {layout.related.map((related) => (
              <Link href={`/${lang}${related.path}`}>{related.label}</Link>
            ))}
          </Cluster>
        )
      }
    </PageHeader>
    <Group layout="flow" mbs="50">
      <PreviewFrame url={previewUrl} hasSizeSwitch files={[{ path: `${layoutPath}/index.astro`, title: 'index.astro' }]} />
    </Group>
  </Flow>
</BaseLayout>

<style>
  .c--pageLayoutPage {
  }
</style>
