---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Stack, AutoColumns, Box } from 'lism-css/astro';
import PatternCard from '@/components/patterns/PatternCard.astro';
import SectionHeader from '@parts/SectionHeader.astro';
import PageHeader from '@parts/PageHeader.astro';
import { pageLayouts, categoryIds, type PageLayoutCategoryId } from '@/config/page-layouts';
import { filterDraftItems } from '@/lib/page-layouts';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}
---

<BaseLayout title="Page Layouts" description="Full-page layout examples built with Lism CSS layout primitives." lang={lang} excludeFromSearch>
  <Stack g="40">
    <PageHeader title="Page Layouts" description="Full-page layout examples built with Lism CSS layout primitives." />

    <Stack g="40">
      {
        categoryIds.map((categoryId: PageLayoutCategoryId) => {
          const category = pageLayouts[categoryId];
          const items = filterDraftItems(category.items);
          if (items.length === 0) return null;
          return (
            <Box as="section">
              <SectionHeader title={category.label} count={items.length} />

              <AutoColumns cols="24rem" g="20" mbs="20">
                {items.map((item) => (
                  <PatternCard
                    href={`/${lang}/page-layouts/${categoryId}/${item.id}`}
                    thumbSrc={`/screenshots/page-layouts/${categoryId}/${item.id}.png`}
                    title={item.title}
                    draft={item.draft}
                  />
                ))}
              </AutoColumns>
            </Box>
          );
        })
      }
    </Stack>
  </Stack>
</BaseLayout>
