---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Flow, Text, Group } from 'lism-css/astro';
import { PreviewFrame } from '@/components/Preview';
import PageHeader from '@parts/PageHeader.astro';
import { patterns, type PatternCategory, type PatternCategoryId } from '@/config/patterns';
import { getAllPatternPaths, getPattern } from '@/lib/patterns';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  const patternPaths = getAllPatternPaths();

  const paths = [];
  for (const lang of nonRootLangs) {
    for (const { category, id } of patternPaths) {
      paths.push({
        params: { lang, category, id },
        props: { lang },
      });
    }
  }
  return paths;
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;
const { category, id } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const pattern = getPattern(category!, id!);

if (!pattern) {
  return Astro.redirect('/404');
}

const categoryData: PatternCategory = patterns[category as PatternCategoryId];

const previewUrl = `/preview/patterns/${category}/${id}/${lang}/`;
const patternPath = `src/pages/preview/patterns/${category}/${id}`;
---

<BaseLayout title={`${pattern.title} - Patterns`} description={pattern.description[lang]} lang={lang} excludeFromSearch noindex>
  <Flow g="30" class="c--patternPage">
    <PageHeader
      title={pattern.title}
      description={pattern.description[lang]}
      draft={pattern.draft}
      backHref={`/${lang}/patterns/${category}/`}
      backLabel={`Back to ${categoryData.label}`}
    >
      <Text slot="eyebrow" tt="uppercase" lts="l">
        {categoryData.label}
      </Text>
    </PageHeader>

    <Group layout="flow" mbs="50">
      <PreviewFrame
        url={previewUrl}
        hasSizeSwitch
        files={[
          { path: `${patternPath}/${lang}.astro`, title: `${lang}.astro` },
          { path: `${patternPath}/_style.css`, title: 'style.css' },
        ]}
      />
    </Group>
  </Flow>
</BaseLayout>

<style>
  .c--patternPage {
  }
</style>
