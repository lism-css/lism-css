---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PatternsIndex from '@/components/patterns/PatternsIndex.astro';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}
---

<BaseLayout title="Patterns" description="Web site patterns built with Lism CSS" lang={lang} excludeFromSearch>
  <PatternsIndex lang={lang} />
</BaseLayout>
