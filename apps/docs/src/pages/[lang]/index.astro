---
/**
 * トップページ（非root言語用）
 * 日本語トップページの翻訳版
 */
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import { Stack, Flex, Lism, Heading, Text, Columns, Box, Icon, Center, Media, Frame, Group } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { siteConfig } from '@/config/site';
import { getLocalizedUrl, isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  // 非root言語のみ対象
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));

  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

// 言語が無効な場合は404
if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

// Features
const features = [
  {
    title: 'Layout Primitives',
    desc: 'Common layout patterns like Stack, Flex, Grid, and Columns are provided as layout primitives. Combine them to build your site structure in no time.',
    src: '/img/features-01.png',
    width: 250,
    height: 175,
    ar: '250/175',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Harmonic Scale',
    desc: 'Spacing, font sizes, and line heights designed with harmonic ratios. A typography system that creates a natural, pleasing rhythm.',
    src: '/img/features-02.png',
    width: 250,
    height: 200,
    ar: '250/200',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Design Tokens',
    desc: 'Colors, font sizes, spacing, border radius, shadows and more — all managed as stepped CSS variables for site-wide consistency.',
    src: '/img/features-03.png',
    width: 200,
    height: 200,
    ar: '200/200',
    widthBase: '9.375rem',
    widthMd: '12.5rem',
  },
  {
    title: 'Property Class',
    desc: 'Style quickly with intuitive class names like -fz:l and -p:20. A clear, concise notation that even AI can understand without confusion.',
    src: '/img/features-04.png',
    width: 200,
    height: 200,
    ar: '200/200',
    widthBase: '10rem',
    widthMd: '12.5rem',
  },
  {
    title: 'CSS Layer Architecture',
    desc: 'A strict CSS layer design powered by @layer. Prevents specificity conflicts while maintaining both extensibility and maintainability.',
    src: '/img/features-05.png',
    width: 250,
    height: 192,
    ar: '250/192',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Responsive',
    desc: 'A unique responsive approach combining CSS variables and classes. Lightweight yet flexible enough for a wide range of layouts.',
    src: '/img/features-06.png',
    width: 248,
    height: 184,
    ar: '248/184',
    widthBase: '11.625rem',
    widthMd: '15.5rem',
  },
];

// 背景ストライプ
const stripes = Array.from({ length: 50 });

// AIツール連携
const tools = [
  {
    title: 'MCP Server',
    body: 'Provides Lism CSS specifications to AI coding tools such as Claude Code, Cursor, and VS Code. AI assists your coding while referencing the latest Lism CSS documentation and API information in real time, so it guides you to the correct class names and props even if you are unsure about Lism’s naming conventions.',
    src: '/img/ai-02.png',
    width: 288,
    height: 200,
  },
  {
    title: 'Skills',
    body: 'Implementation guide skills for AI agents. By correctly understanding Lism CSS’s naming conventions and design principles, AI can generate accurate code that follows best practices. Works with Claude Code and other popular AI coding tools.',
    src: '/img/ai-03.png',
    width: 215,
    height: 200,
  },
];

// プリセット
const presets = [
  {
    src: '/img/preset-img-01.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-02.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-03.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-04.png',
    width: 408,
    height: 194,
  },
  {
    src: '/img/preset-img-05.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-06.png',
    width: 408,
    height: 228,
  },
  {
    src: '/img/preset-img-07.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-08.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-09.png',
    width: 408,
    height: 231,
  },
];
---

<SimpleLayout title={siteConfig.name} description="The official documentation site for Lism CSS." lang={lang} schemaType="HomePage" excludeFromSearch>
  {/* 背景動画：スクロールしても固定表示 */}
  {/* inert: Firefoxではvideo要素がフォーカス可能なため、装飾用背景をタブ順から除外 */}
  <Box pos="fixed" i-x="0" t="0" h="100vh" z="-1" ov="hidden" bgc="base" inert aria-hidden="true" style={{ mixBlendMode: 'darken' }}>
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline>
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Box pos="absolute" i="0" style={{ backdropFilter: 'blur(80px)' }} />
    <Box pos="absolute" i="0" style={{ mixBlendMode: 'overlay' }}>
      <Flex pos="absolute" i="0" jc="center">
        {
          stripes.map(() => (
            <Box
              w="64px"
              h="100%"
              fxsh="0"
              bd-l
              bdc="rgba(255, 255, 255, 0.05)"
              bg="linear-gradient(90deg, rgba(255, 255, 255, 0.30) 0%, rgba(34, 34, 34, 0.30) 60%, rgba(0, 0, 0, 0.30) 70%, rgba(34, 34, 34, 0.30) 80%, rgba(255, 255, 255, 0.30) 100%)"
            />
          ))
        }
      </Flex>
    </Box>
  </Box>
  <Lism as="section" isWrapper="l" px="20">
    <Stack as="div" ai="center" pbs={{ base: '9rem', md: '14rem' }} pbe={{ md: '60' }}>
      <Heading ta="center" level="1" fw="700" fz={{ base: '2.25rem', md: '5xl' }} lh="1.25" c="var(--gray-hi-c)" lts="var(--lts--tight)">
        The CSS Design <Lism as="br" d={{ base: 'inherit', md: 'none' }} />Framework<br />for AI and Humans
      </Heading>
      <Text class="c--line-height" ta="center" fz={{ base: 's', md: 'l' }} c="#333" mt="30" style={{ '--lh--base': '1.5', '--lh--l': '1.75' }}>
        Lightweight and build-free. Works on any site.<br />
        You never have to worry about CSS architecture again.
      </Text>
      <Flex g={{ base: '15', md: '20' }} ai="center" jc="center" mt="40" w="100%">
        <Button
          href={getLocalizedUrl('/docs/installation/', lang)}
          fz={{ base: 's', md: 'base' }}
          bdrs="var(--bdrs--15)"
          bd="none"
          bgc="var(--gray-hi-c)"
          hov={{ bgc: 'var(--link)' }}
          fw="500"
          lh="1.5"
          px="10"
          g="0"
        >
          <Lism as="span" px={{ base: '0.375rem', md: '10' }}>Get Started</Lism>
          <Icon icon="caret-right" style={{ scale: '1' }} />
        </Button>
        <Box pos="relative" max-w={{ base: '11.8125rem', md: '16.6875rem' }} w="100%" bd="none" aslf="stretch">
          <input id="kv-search" class="c--kv-search c--shadow-box" type="text" placeholder="Search documentation..." autocomplete="off" />
          <Lism
            as="button"
            type="button"
            class="c--searchTrigger"
            px="10"
            py="0.125rem"
            h="fit-content"
            bd="none"
            bgc="transparent"
            g="5"
            bdrs="10"
            pos="absolute"
            r="10"
            i-y="0"
            d={{ base: 'none', md: 'flex' }}
            hov="-c"
            data-modal-open="search-modal"
          >
            <Lism as="kbd" class="c--searchTrigger_shortcut" p="0" bxsh="none" bd="none" fz="base" ff="base" lh="1.25" lts="var(--lts--tighter)"
              >⌘K</Lism
            >
          </Lism>
        </Box>
      </Flex>
      {/* TODO: AIコード生成のイメージ図。フロント確認のため画像で配置。実装方法変更予定 */}
      <Group bxsh="var(--bxsh--code)" bdrs="0.625rem" mbs={{ base: '40', md: '3.5rem' }}>
        <Media src="/svg/code-pc.svg" alt="" width="903" height="400" d={{ base: 'none', md: 'block' }} />
        <Media src="/svg/code-sp.svg" alt="" width="368" height="552" d={{ base: 'block', md: 'none' }} />
      </Group>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Features</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">A Sophisticated Design Theory</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="48em">
        Lism CSS is a lightweight CSS framework for building the structural foundation of your website quickly and smoothly. Its CSS architecture is
        designed from the ground up to bring a natural, pleasing rhythm to your designs.
      </Text>

      <Columns cols={{ base: 1, md: 2, lg: 3 }} g="10" mbs={{ base: '50', md: '60' }}>
        {
          features.map((card) => (
            <Stack class="c--shadow-box" p="40">
              <Text fw="700" lh="1.5" c="var(--gray-hi-c)" lts="var(--lts--tight)" fz={{ base: 'base', md: '1.5rem' }}>
                {card.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" fxg="1">
                {card.desc}
              </Text>
              <Media
                src={card.src}
                alt=""
                width={card.width}
                height={card.height}
                mx="auto"
                mt="50"
                ar={card.ar}
                w={{ base: card.widthBase, md: card.widthMd }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter pos="relative">
    {/* AIツール連携セクション背景画像 */}
    <Group
      pos="absolute"
      w={{ base: '121.875rem', md: '162.5rem' }}
      l="50%"
      t="clamp(-2.625rem, calc(-2rem - 1.25vw), -2rem)"
      ms={{ base: '-60.9375rem', md: '-81.25rem' }}
      z="-1"
      max-w="none"
      aria-hidden="true"
    >
      <Media src="/img/ai-bg.png" alt="" width="2600" height="1559" w="100%" h="auto" />
    </Group>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Artificial Intelligence</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">AI Tool Integration</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="48em">
        Lism CSS is designed with AI agents in mind. With an MCP server, Skills, and machine-readable documentation, AI tools like Claude Code and
        Cursor can accurately understand the Lism system and generate code that matches your intent.
      </Text>
      <Frame mt="50" w={{ base: '18.375rem', md: '24.5625rem' }}>
        <Media src="/img/ai-01.png" alt="" width="393" height="240" />
      </Frame>
      <Columns cols={{ base: 1, md: 2 }} g="10" w="100%" mt="50">
        {
          tools.map((item) => (
            <Stack class="c--shadow-box" p="40">
              <Text c="var(--gray-hi-c)" fw="700" fz={{ base: 'base', md: '1.5rem' }} lh="1.5" lts="var(--lts--tight)">
                {item.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" max-w={{ base: '100%', md: '24rem' }} fxg="1">
                {item.body}
              </Text>
              <Media
                src={item.src}
                alt=""
                width={item.width}
                height={item.height}
                mbs={{ base: '50', md: '35' }}
                ms="auto"
                me={{ base: 'auto', md: '0' }}
                w="auto"
                h={{ base: '9.375rem', md: '12.5rem' }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Templates</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '4xl' }} fw="700" lh="1.5" c="var(--gray-hi-c)" lts="var(--lts--tight)"
          >Lism CSS Templates</Heading
        >
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="35em">
        Use them as a base for your design, or copy and paste just the parts you need to instantly add polished layouts to your project.
      </Text>
      <Button
        href={getLocalizedUrl('/templates/', lang)}
        fz={{ base: 's', md: 'base' }}
        bdrs="var(--bdrs--15)"
        bd="none"
        bgc="var(--gray-hi-c)"
        hov={{ bgc: 'var(--link)' }}
        mt="40"
        fw="500"
        lh="1.5"
        px="10"
        g="0"
      >
        <Lism as="span" px={{ base: '0.375rem', md: '10' }}>View More</Lism>
        <Icon icon="caret-right" style={{ scale: '1' }} />
      </Button>
      <Box mbs={{ base: '50', md: '60' }} mx="clamp(-6.375rem, calc(22.921vw - 12.106rem), 0rem)" cg="10" style={{ columnCount: 3 }}>
        {
          presets.map((item) => (
            <Frame class="c--shadow-box" mbe={{ base: '5', md: '10' }}>
              <Media src={item.src} alt="" width={item.width} height={item.height} />
            </Frame>
          ))
        }
      </Box>
    </Stack>
  </Lism>

  {/* CTA */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" pt="10.625rem">
      <Center class="c--shadow-box" ai="center" w="100%" max-w="l" min-h="calc(100svh - 21.25rem)" px={{ base: '15', md: '40' }} py="40">
        <Stack ai="center" g="15">
          <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Get Started</Text>
          <Heading level="2" ta="center" fz={{ base: '2xl', md: '4xl' }} fw="700" lh="1.5" c="var(--gray-hi-c)" lts="var(--lts--tight)"
            >Lism CSS Works Everywhere</Heading
          >
        </Stack>
        <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'base' }} lh="1.75" lts="var(--lts--tight)">
          No build process, no setup required.<br />Just load a single CSS file to add Lism CSS to your site.
        </Text>
        <Button
          href={getLocalizedUrl('/docs/installation/', lang)}
          fz={{ base: 's', md: 'base' }}
          bdrs="var(--bdrs--15)"
          bd="none"
          bgc="var(--gray-hi-c)"
          hov={{ bgc: 'var(--link)' }}
          mt="40"
          fw="500"
          lh="1.5"
          px="10"
          g="0"
        >
          <Lism as="span" px={{ base: '6px', md: '10' }}>Get Started</Lism>
          <Icon icon="caret-right" style={{ scale: '1' }} />
        </Button>
      </Center>
    </Stack>
  </Lism>
</SimpleLayout>

<script>
  const kvSearch = document.getElementById('kv-search');
  kvSearch?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const query = (e.target as HTMLInputElement).value.trim();
    if (!query) return;
    document.querySelector<HTMLElement>('[data-modal-open="search-modal"]')?.click();
    setTimeout(() => {
      const pfInput = document.querySelector<HTMLInputElement>('#search input[type="text"]');
      if (pfInput) {
        pfInput.value = query;
        pfInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }, 50);
  });
</script>

<style>
  /* トップページは日本語版とフォントスケールを統一（_base.scss の html[lang='en'] { --fz-mol: 7 } を上書き） */
  :global(html) {
    --fz-mol: 8;
  }

  video {
    position: absolute;
    top: 0;
    width: 100%;
    height: 150vh;
    object-fit: cover;
  }

  .c--kv-search {
    padding: var(--s10) 0.875rem;
    font-size: var(--fz--s);
    width: 100%;
    height: 100%;
    border: none;
    line-height: 1.5;
    @container (min-width: 800px) {
      padding-left: var(--s20);
      font-size: var(--fz--base);
    }
  }

  /* 検索トリガーボタン */
  .c--searchTrigger {
    box-shadow: var(--bxsh--search-border);
    background: var(--lightgray-hi);
    align-self: center;
  }
</style>
