---
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import KvEditor from '@/components/KvEditor/KvEditor.astro';
import { Stack, Lism, Flex, Heading, Text, Link, Columns, Grid, Box, Icon, Center, Media, Frame, Group } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { siteConfig } from '@/config/site';
import { getLocalizedUrl, isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));

  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const features = [
  {
    title: 'Layout Primitives',
    desc: 'Common layout patterns like Stack, Flex, Grid, and Columns are provided as layout primitives. Combine them to build your site structure in no time.',
    src: '/img/features-layout.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Harmonic Scale',
    desc: 'Spacing, font sizes, and line heights designed with harmonic ratios. A typography system that creates a natural, pleasing rhythm.',
    src: '/img/features-scale.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Design Tokens',
    desc: 'Colors, font sizes, spacing, border radius, shadows and more — all managed as stepped CSS variables for site-wide consistency.',
    src: '/img/features-tokens.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Property Class',
    desc: 'Style quickly with intuitive class names like -fz:l and -p:20. A clear, concise notation that even AI can understand without confusion.',
    src: '/img/features-props.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'CSS Layer Architecture',
    desc: 'A strict CSS layer design powered by @layer. Prevents specificity conflicts while maintaining both extensibility and maintainability.',
    src: '/img/features-layer.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Responsive',
    desc: 'A unique responsive approach combining CSS variables and classes. Lightweight yet flexible enough for a wide range of layouts.',
    src: '/img/features-responsive.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
];

const tools = [
  {
    title: 'MCP Server',
    buttonLabel: 'Connect MCP',
    href: '/docs/mcp/',
    body: 'Provides Lism CSS specifications to AI coding tools such as Claude Code, Cursor, and VS Code. AI assists your coding while referencing the latest Lism CSS documentation and API information in real time, so it guides you to the correct class names and props even if you are unsure about Lism’s naming conventions.',
    src: '/img/ai-02.png',
    width: 1120,
    height: 840,
  },
  {
    title: 'Skills',
    buttonLabel: 'Get Skills',
    href: '/docs/skills/',
    body: 'Implementation guide skills for AI agents. By correctly understanding Lism CSS’s naming conventions and design principles, AI can generate accurate code that follows best practices. Works with Claude Code and other popular AI coding tools.',
    src: '/img/ai-03.png',
    width: 1120,
    height: 840,
  },
];

const presets = [
  {
    src: '/img/preset-img-01.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-02.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-03.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-04.png',
    width: 408,
    height: 194,
  },
  {
    src: '/img/preset-img-05.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-06.png',
    width: 408,
    height: 228,
  },
  {
    src: '/img/preset-img-07.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-08.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-09.png',
    width: 408,
    height: 231,
  },
];
---

<SimpleLayout title={siteConfig.name} description="The official documentation site for Lism CSS." lang={lang} schemaType="HomePage" excludeFromSearch>
  {/* inert: Firefoxではvideo要素がフォーカス可能なため、装飾用背景をタブ順から除外 */}
  <Box class="c--kvVideoBg" pos="fixed" i-x="0" t="0" z="-1" h="100vh" ov="hidden" bgc="base" inert aria-hidden="true">
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline>
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Box pos="absolute" i="0" style={{ backdropFilter: 'blur(80px)' }} />
    <Box class="c--kvStripes" pos="absolute" i="0" style={{ mixBlendMode: 'overlay' }} />
  </Box>
  <Lism as="section" isWrapper="l" px="20">
    {
      /* ヒーローはライブコードエディター（KvEditor）の描画結果。位置決め（上下padding）は
        エディター外なのでレスポンシブ可。任意色・影は _kv-editor.scss の .c--kvEditorHero に集約 */
    }
    <Box pbs={{ base: '9rem', md: '14rem' }} pbe={{ md: '60' }}>
      <KvEditor lang={lang} />
    </Box>
  </Lism>

  {/* 機能紹介 */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Features</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>A Sophisticated Design Theory</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="48em">
        Lism CSS is a lightweight CSS framework for building the structural foundation of your website quickly and smoothly. Its CSS architecture is
        designed from the ground up to bring a natural, pleasing rhythm to your designs.
      </Text>

      <Columns cols={[1, null, 2, 3]} g="10" w="100%" mbs={['50', null, '60']}>
        {
          features.map((card) => (
            <Grid class="b--shadowBox" p={['30', '35', '40']} gtr="1fr auto" g={['40', '50']}>
              <Stack g="25">
                <Heading level="3" class="c--topHeading" fz={['l', 'xl']}>
                  {card.title}
                </Heading>
                <Text fz={['s', 'm']} class="u--trim">
                  {card.desc}
                </Text>
              </Stack>
              <Media
                src={card.src}
                alt=""
                width={card.width}
                height={card.height}
                mx="auto"
                aslf="end"
                ar={card.ar}
                w={{ base: card.widthBase, md: card.widthMd }}
                max-w="100%"
              />
            </Grid>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  {/* AIツール連携 */}
  <Lism as="section" class="c--ai-section" isWrapper="l" hasGutter pos="relative" z="1">
    <Group
      class="c--ai-bg"
      pos="absolute"
      w={['100rem', null, '120rem']}
      l="50%"
      t="0%"
      z="-1"
      max-w="none"
      style={{ translate: '-50% 0%' }}
      aria-hidden="true"
    >
      <Media src="/img/ai-bg.png" alt="" width="2600" height="1559" w="100%" h="auto" />
    </Group>
    <Stack as="div" ai="center" py={['60', null, '70']}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Artificial Intelligence</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>AI Tool Integration</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="48em">
        Lism CSS is designed with AI agents in mind. With an MCP server, Skills, and machine-readable documentation, AI tools like Claude Code and
        Cursor can accurately understand the Lism system and generate code that matches your intent.
      </Text>
      <Frame mt={['45', null, '50']} w={['16rem', '18rem', '20rem', '24rem']} z="1">
        <Media src="/img/ai-01.png" alt="" width="1120" height="840" style={{ filter: 'drop-shadow(1px 3px 2px rgb(0 0 0 / 0.1))' }} />
      </Frame>
      <Columns
        class="b--shadowBox"
        cols={[1, null, 2]}
        g="0"
        pt={{ md: '50' }}
        pb={{ md: '45' }}
        w="100%"
        mt={['45', null, '-3.75rem', '-4.25rem']}
        ov="hidden"
      >
        {
          tools.map((item, index) => (
            <Stack
              px={['30', '35', '40']}
              py={['30', '35', '25']}
              g={['25', null, '30']}
              bd={index > 0}
              bdc="var(--shc)"
              bdw={index > 0 ? { base: '1px 0 0', md: '0 0 0 1px' } : undefined}
            >
              <Flex fxd={['row', null, 'column']} jc="between" ai="center" g={['15', null, '30']}>
                <Heading level="3" class="c--topHeading u--trim" fz={['xl', null, '2xl', '3xl']}>
                  {item.title}
                </Heading>
                <Media src={item.src} alt="" width={item.width} height={item.height} w={['25%', null, '10rem']} h="auto" />
              </Flex>
              <Text fz={['s', 'm']}>{item.body}</Text>
              <Link href={getLocalizedUrl(item.href, lang)} fz={['s', 'm']} mt="auto" aslf="flex-end">
                <span>{item.buttonLabel} →</span>
              </Link>
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  {/* テンプレート */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Templates</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>Lism CSS Templates</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="35em">
        Use them as a base for your design, or copy and paste just the parts you need to instantly add polished layouts to your project.
      </Text>
      <Button class="c--lpButton" href={getLocalizedUrl('/templates/', lang)} fz={['s', 'm']} hov={{ bgc: 'var(--link)' }} mt="40">
        <span>View More</span>
        <Icon icon="caret-right" />
      </Button>
      <Box mbs={{ base: '50', md: '60' }} mx="clamp(-6.375rem, calc(22.921vw - 12.106rem), 0rem)" cg="10" style={{ columnCount: 3 }}>
        {
          presets.map((item) => (
            <Frame class="b--shadowBox" mbe={{ base: '5', md: '10' }}>
              <Media src={item.src} alt="" width={item.width} height={item.height} />
            </Frame>
          ))
        }
      </Box>
    </Stack>
  </Lism>

  {/* CTA */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" pt={['60', '70']}>
      <Center class="b--shadowBox" ai="center" w="100%" max-w="l" min-h="min(125vw, calc(100svh - 21.25rem))" px={['30', '40']} py="40">
        <Stack ai="center" g={['25', '30', '35']}>
          <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Get Started</Text>
          <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>Lism CSS Works Everywhere</Heading>
        </Stack>
        <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']}>
          No build process, no setup required.<br />Just load a single CSS file to add Lism CSS to your site.
        </Text>
        <Button class="c--lpButton" href={getLocalizedUrl('/docs/installation/', lang)} fz={['s', 'm']} hov={{ bgc: 'var(--link)' }} mt="40">
          <span>Get Started</span>
          <Icon icon="caret-right" />
        </Button>
      </Center>
    </Stack>
  </Lism>
</SimpleLayout>

<style>
  /* トップページは日本語版とフォントスケールを統一（_theme.scss の html[lang='en'] { --fz-mol: 7 } を上書き） */
  :global(html) {
    --fz-mol: 8;
  }
</style>
