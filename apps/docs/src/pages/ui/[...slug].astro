---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { generateToc } from '@/lib/generateToc';
import { Icon, Lism, Flow } from 'lism-css/astro';
import PostNavigation from '@parts/PostNavigation.astro';
import ArticleTitle from '@parts/ArticleTitle.astro';
import { getRootLang, type LangCode } from '@/lib/i18n';
import { getUiPostsByLang, type PostEntry } from '@/lib/content';
import { render } from 'astro:content';

import * as mdxComponents from '@/components/mdx';

export async function getStaticPaths() {
  const rootLang = getRootLang();
  const uiPosts = await getUiPostsByLang(rootLang);

  return uiPosts.map((entry) => ({
    params: { slug: entry.id.replace(/^ui\//, '') },
    props: { lang: rootLang, entry },
  }));
}

const { lang, entry } = Astro.props as { lang: LangCode; entry: PostEntry };
const { Content, headings } = await render(entry);

const toc = generateToc(headings);

const ogImage = `/ui/og/${entry.id.replace(/^ui\//, '')}.png`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={ogImage}
  toc={toc}
  lang={lang}
  schemaType="TechArticle"
  date={entry.data.date}
>
  <Lism as="article" class="c--article set--cqUnit set--s" data-pagefind-body>
    <ArticleTitle title={entry.data.title} eyebrow={entry.data.eyebrow} />

    <Lism class="u--cbox" keycolor="yellow" p="20" my="40" bdrs="10" bd>
      <Lism layout="flex" ai="center" g="10" fw="bold">
        <Icon icon="warning" fz="l" c="keycolor" />
        このページは現在調整中です
      </Lism>
      <Lism fz="s" mbs="5"> Lism UI (@lism-css/ui) はまだ準備中です。</Lism>
    </Lism>

    <Flow class="c--content" mbs="40">
      <Content components={mdxComponents} />
    </Flow>

    <PostNavigation currentSlug={entry.id} lang={lang} />
  </Lism>
</BaseLayout>
