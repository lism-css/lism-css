---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UiComponentCard from '@/components/ui/UiComponentCard.astro';
import { AutoColumns, Lism, Text } from 'lism-css/astro';
import SectionHeader from '@parts/SectionHeader.astro';
import PageHeader from '@parts/PageHeader.astro';
import { getUiPostsByLang } from '@/lib/content';
import { getRootLang } from '@/lib/i18n';

const currentLang = getRootLang();
const allUiPosts = await getUiPostsByLang(currentLang);

const byOrder = (a: (typeof allUiPosts)[number], b: (typeof allUiPosts)[number]) => (a.data.order ?? 999) - (b.data.order ?? 999);

const blockExamplePosts = allUiPosts.filter((post) => post.id.startsWith('ui/block-examples/')).sort(byOrder);

const componentPosts = allUiPosts.filter((post) => post.id.startsWith('ui/components/')).sort(byOrder);

const blockPosts = allUiPosts.filter((post) => !post.id.startsWith('ui/block-examples/') && !post.id.startsWith('ui/components/')).sort(byOrder);

const getPostUrl = (post: (typeof allUiPosts)[number]) => `/ui/${post.id.replace('ui/', '')}/`;
---

<BaseLayout title="Lism UI" description="Lism CSSをベースにしたUIパッケージ、@lism-css/ui のコンポーネント一覧" excludeFromSearch>
  <Lism>
    <PageHeader title="Lism UI">
      <Fragment slot="description"
        >Lism CSSをベースにしたUIパッケージ（<code>@lism-css/ui</code>） のコンポーネント一覧と、実装例・サンプル集を紹介します。</Fragment
      >
    </PageHeader>
    <Lism as="section" mbs="50">
      <SectionHeader title="Blocks">
        <Text><code>@lism-css/ui</code>からインポートできるコンポーネント一覧です。</Text>
      </SectionHeader>
      <AutoColumns class="c--uiComponentList" cols="240px" g="5" mbs="40">
        {blockPosts.map((post) => <UiComponentCard href={getPostUrl(post)} title={post.data.title} draft={post.data.draft} />)}
      </AutoColumns>
    </Lism>
    {
      blockExamplePosts.length > 0 && (
        <Lism as="section" mbs="50">
          <SectionHeader title="Block Examples">
            <Text>
              CSSをコピーして導入する<code>b--</code>部品の作例です。
            </Text>
          </SectionHeader>
          <AutoColumns class="c--uiComponentList" cols="240px" g="5" mbs="40">
            {blockExamplePosts.map((post) => (
              <UiComponentCard href={getPostUrl(post)} title={post.data.title} draft={post.data.draft} />
            ))}
          </AutoColumns>
        </Lism>
      )
    }
    {
      componentPosts.length > 0 && (
        <Lism as="section" mbs="50">
          <SectionHeader title="Components">
            <Text>Lism CSS, Lism UIをベースにした、その他の実装例・サンプル集です。</Text>
          </SectionHeader>
          <AutoColumns class="c--uiComponentList" cols="240px" g="5" mbs="40">
            {componentPosts.map((post) => (
              <UiComponentCard href={getPostUrl(post)} title={post.data.title} draft={post.data.draft} />
            ))}
          </AutoColumns>
        </Lism>
      )
    }
  </Lism>
</BaseLayout>
