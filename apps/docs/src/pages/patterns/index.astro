---
/**
 * パターン一覧ページ
 *
 * カテゴリ別にパターンを一覧表示
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Stack, AutoColumns, Frame, BoxLink, Box, Lism, Text, Inline, Heading, Cluster, Link } from 'lism-css/astro';
import { patterns, categoryIds, type PatternCategory, type PatternCategoryId } from '@/config/patterns';
import { filterDraftItems } from '@/lib/patterns';
---

<BaseLayout title="Patterns" description="Lism CSSを使ったWebサイトパターン集" excludeFromSearch>
  <Stack g="40" class="patterns">
    <Stack as="header" g="20">
      <h1>Web Patterns</h1>
      <Text c="text-2">コピペで簡単に利用できる、Lism CSSを使ったWebサイトパターン集です。</Text>
    </Stack>

    <Stack g="40">
      {
        categoryIds.map((categoryId: PatternCategoryId) => {
          // satisfies による推論では related を持たないカテゴリで型が絞られるため、共通の型で受ける
          const category: PatternCategory = patterns[categoryId];
          // 本番環境ではdraft:trueのアイテムを除外
          const items = filterDraftItems(category.items);
          return (
            /* idはリダイレクト元URLのアンカー先として使う */
            <Box as="section" id={categoryId}>
              <Heading level="2" layout="flex" ai="center" g="10" fz="xl" bd-b py="10" px="5">
                <span>{category.label}</span>
                <Inline fz="xs" c="text-2" fw="normal">
                  ({items.length})
                </Inline>
              </Heading>

              <Stack g="5" mbs="15" px="5">
                <Text fz="s" c="text-2">
                  {category.description.ja}
                </Text>
                {category.related && (
                  <Cluster g="15" fz="xs">
                    {category.related.map((related) => (
                      <Link href={related.path}>{related.label}</Link>
                    ))}
                  </Cluster>
                )}
              </Stack>

              <AutoColumns cols="24rem" g="20" mbs="20" class="patternList">
                {items.map((item) => (
                  <BoxLink class="patternList_link" layout="stack" href={`/patterns/${categoryId}/${item.id}`} p="10" g="20" set="hov">
                    {/* スクリーンショット画像をサムネイルとして表示 */}
                    <Frame ar="3/2" bd bdrs="20" ov="hidden">
                      <img
                        src={`/screenshots/patterns/${categoryId}/${item.id}.png`}
                        alt={item.title}
                        loading="lazy"
                        decoding="async"
                        class="patternList_thumb"
                      />
                    </Frame>
                    <Lism layout="cluster" g="10" class="u--trim -ff:mono -fz:s">
                      {item.title}
                    </Lism>
                  </BoxLink>
                ))}
              </AutoColumns>
            </Box>
          );
        })
      }
    </Stack>
  </Stack>
</BaseLayout>

<style>
  /* サムネイルカードのスタイル */
  .patternList_link > .l--frame {
    --bdw: 2px;
    transition: box-shadow 0.2s;
    box-shadow: var(--_isHov, var(--bxsh--30)) var(--_notHov, var(--bxsh--10));
  }

  /* サムネイル画像のスタイル */
  .patternList_thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.3s ease;
  }

  /* ホバー時のズーム効果 */
  .patternList_link:hover .patternList_thumb {
    transform: scale(1.02);
  }
</style>
