---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Flow, Text, Group } from 'lism-css/astro';
import { PreviewFrame } from '@/components/Preview';
import PageHeader from '@parts/PageHeader.astro';
import { getAllPatternPaths, getPattern, getPatternCategoryForItem } from '@/lib/patterns';

export function getStaticPaths() {
  const paths = getAllPatternPaths();
  return paths.map(({ category, id }) => ({
    params: { category, id },
  }));
}

const { category, id } = Astro.params;
const pattern = getPattern(category!, id!);

if (!pattern) {
  return Astro.redirect('/404');
}

const categoryData = getPatternCategoryForItem(category!, id!)!;

const previewUrl = `/preview/patterns/${category}/${id}/`;
const patternPath = `src/pages/preview/patterns/${category}/${id}`;
const stylePath = `${patternPath}/_style.css`;
const hasStyle = existsSync(resolve(process.cwd(), stylePath));
---

<BaseLayout title={`${pattern.title} - Patterns`} description={pattern.description.ja} excludeFromSearch noindex>
  <Flow g="30" class="c--patternPage">
    <PageHeader
      title={pattern.title}
      description={pattern.description.ja}
      draft={pattern.draft}
      breadcrumbs={[
        { label: 'Patterns', href: '/patterns/' },
        { label: `${categoryData.label}一覧`, href: `/patterns/${categoryData.id}/` },
        { label: pattern.id.match(/\d+$/)?.[0] ?? pattern.id },
      ]}
    >
      <Text slot="eyebrow" tt="uppercase" lts="l">
        {categoryData.label}
      </Text>
    </PageHeader>

    <Group layout="flow" mbs="50">
      <PreviewFrame
        url={previewUrl}
        hasSizeSwitch
        files={[{ path: `${patternPath}/index.astro`, title: 'index.astro' }, ...(hasStyle ? [{ path: stylePath, title: 'style.css' }] : [])]}
      />
    </Group>
  </Flow>
</BaseLayout>

<style>
  .c--patternPage {
  }
</style>
