---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Columns, Cluster, Divider, Flex, Group, Heading, Inline, Stack, Text, Wrapper } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="Hero003">
  <Group as="section" className="c--deployHero" isContainer hasGutter bgc="text" c="base">
    <Wrapper contentSize="xl" py={['40', null, '50']}>
      <Stack g="40">
        <Stack ai="center" ta="center" g="30">
          <Inline fz="s" o="p">安心して、次のリリースへ</Inline>
          <Heading level="1" className="u--trim" fz={['2xl', null, '4xl']} fw="bold" hl="xs" max-sz="l">
            リリースを、<br />待ち時間にしない。
          </Heading>
          <Text className="u--trim" fz="m" hl="l" o="p" max-sz="m"> ビルドから配信までを自動化。作業の状態を、チーム全員で確認できます。 </Text>
          <Cluster jc="center" g="15">
            <Button href="#" bgc="blue" c="white" px="30" py="15" bdrs="99" fw="bold">無料でデプロイ</Button>
            <Button href="#" variant="outline" keycolor="base" c="base" px="30" py="15" bdrs="99" fw="bold">ドキュメントを読む</Button>
          </Cluster>
        </Stack>

        <Group as="figure" bgc="black" bd bdc="gray" bdrs="30" ov="hidden">
          <Flex jc="between" ai="center" p="20" bd-be bdc="gray">
            <Cluster g="10" aria-hidden="true">
              <Inline d="block" p="5" bgc="red" bdrs="99" />
              <Inline d="block" p="5" bgc="yellow" bdrs="99" />
              <Inline d="block" p="5" bgc="green" bdrs="99" />
            </Cluster>
            <Inline d={['none', 'inline']} ff="mono" fz="2xs" o="p">release-2026-05-24</Inline>
            <Inline ff="mono" fz="2xs" c="green">● LIVE</Inline>
          </Flex>
          <Stack g="15" p="25" ff="mono">
            <Text fz="s"><Inline c="blue">→</Inline> nova deploy --production</Text>
            <Text fz="s" o="p">環境を確認しています...</Text>
            <Text fz="s"><Inline c="green">✓</Inline> 依存関係を取得 <Inline o="pp">1.2s</Inline></Text>
            <Text fz="s"><Inline c="green">✓</Inline> アプリケーションをビルド <Inline o="pp">8.4s</Inline></Text>
            <Text fz="s"><Inline c="green">✓</Inline> 12のエッジ拠点へ配信 <Inline o="pp">2.1s</Inline></Text>
            <Text fz="s" c="green">公開しました → app.nova.dev</Text>
          </Stack>
          <Divider bdc="gray" />
          <Columns cols={3}>
            <Stack g="10" p="20">
              <Inline fz="2xs" ff="mono" o="p">ビルド時間</Inline>
              <Inline fz="xl" ff="mono" fw="bold">11.7s</Inline>
            </Stack>
            <Stack g="10" p="20">
              <Inline fz="2xs" ff="mono" o="p">配信拠点</Inline>
              <Inline fz="xl" ff="mono" fw="bold">12</Inline>
            </Stack>
            <Stack g="10" p="20">
              <Inline fz="2xs" ff="mono" o="p">状態</Inline>
              <Inline fz="xl" ff="mono" fw="bold" c="green">正常</Inline>
            </Stack>
          </Columns>
        </Group>
      </Stack>
    </Wrapper>
  </Group>
</DemoLayout>
