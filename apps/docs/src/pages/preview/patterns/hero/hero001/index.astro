---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Flex, Media, Layer, Text, Inline, Heading } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import './_style.css';
---

<DemoLayout title="Hero001">
  <Stack pos="relative" min-h="70svh" jc="center" c="white">
    {/* 背景画像と暗いオーバーレイ */}
    <Frame isLayer>
      <Media isLayer src="https://cdn.lism-css.com/img/a-1.jpg" alt="" width="960" height="640" />
      <Layer bgc="black:50%" />
    </Frame>
    {/* 中央に重ねるコンテンツ */}
    <Container isWrapper="s" hasGutter py="60" z="1">
      <Stack ai="center" g="40">
        <Stack ai="center" g="25">
          <Inline class="u--trim" fz="s" ff="mono" lts="xl" ta="center">OCEAN VIEW RESORT</Inline>
          <Heading level="1" class="u--trim" fz="4xl" fw="bold" hl="s" ta="center">海と空だけの、<br />静かな時間へ。</Heading>
          <Text class="u--trim" fz="m" hl="l" ta="center">
            波の音で目を覚まし、水平線に沈む夕日を眺める。<br />何もしない贅沢を味わうための、全8室の小さな宿です。
          </Text>
        </Stack>
        <Flex g="20 30" fxw="wrap" jc="center">
          <Button href="#" bgc="white" c="black" bdrs="99" px="40" py="15" fw="bold" hasTransition hov={{ bgc: 'accent', c: 'white' }}>
            空室を確認する
          </Button>
          <Button href="#" variant="outline" c="white" bdrs="99" px="40" py="15" fw="bold" hasTransition hov={{ bgc: 'white', c: 'black' }}>
            客室を見る
          </Button>
        </Flex>
      </Stack>
    </Container>
  </Stack>
</DemoLayout>
