---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Cluster, Divider, Flex, Group, Heading, Inline, Stack, Text, WithSide, Wrapper } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="Hero004">
  <Group as="section" className="c--studioHero" isContainer hasGutter bgc="orange:10%">
    <Wrapper contentSize="xl" py={['40', null, '50']}>
      <Stack g="40">
        <Cluster jc="between" g="30">
          <Inline fw="bold" lts="l">ATELIER NAMI</Inline>
          <Cluster g="20" fz="xs" ff="mono">
            <Inline>ISSUE 04</Inline>
            <Inline o="p">TOKYO / 2026</Inline>
          </Cluster>
        </Cluster>
        <Divider bdc="text" />
        <Stack g="35">
          <Inline fz="2xs" ff="mono" lts="xl">ブランドとデザインのスタジオ</Inline>
          <Heading level="1" className="u--trim" fz={['2xl', null, '4xl']} ff="accent" fw="light" hl="xs" max-sz="xl">
            <Inline d="inline-block">まだ名前のない</Inline><Inline d="inline-block">魅力に、</Inline><br />輪郭を与える。
          </Heading>
        </Stack>
        <Divider bdc="text" />
        <WithSide sideW="xs" mainW="xs" g="40 50">
          <Stack g="30">
            <Text fz="m" hl="l">
              私たちは、言葉と造形の両方からブランドを設計するデザインスタジオです。観察し、問いを立て、長く使える個性へ整えます。
            </Text>
            <Cluster g="15">
              <Button href="#" bgc="text" c="base" px="30" py="15" bdrs="0" fw="bold">プロジェクトを相談する</Button>
              <Button href="#" variant="outline" keycolor="text" px="30" py="15" bdrs="0">制作事例を見る</Button>
            </Cluster>
          </Stack>
          <Stack isSide g="20">
            <Flex jc="between" g="30" pb="20" bd-be bdc="text">
              <Inline ff="mono" fz="xs" fxsh="0">01</Inline>
              <Inline fw="bold">ブランド戦略と言語設計</Inline>
            </Flex>
            <Flex jc="between" g="30" pb="20" bd-be bdc="text">
              <Inline ff="mono" fz="xs" fxsh="0">02</Inline>
              <Inline fw="bold">ビジュアルアイデンティティ</Inline>
            </Flex>
            <Flex jc="between" g="30" pb="20" bd-be bdc="text">
              <Inline ff="mono" fz="xs" fxsh="0">03</Inline>
              <Inline fw="bold">Web・デジタルプロダクト</Inline>
            </Flex>
          </Stack>
        </WithSide>
        <Cluster jc="between" g="30" fz="2xs" ff="mono" lts="l">
          <Inline>SELECTED WORKS 2023—2026</Inline>
          <Inline>SCROLL TO EXPLORE ↓</Inline>
        </Cluster>
      </Stack>
    </Wrapper>
  </Group>
</DemoLayout>
