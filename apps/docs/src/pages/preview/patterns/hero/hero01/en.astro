---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Flex, Media, Layer, Icon, Text, Inline, Link, Heading } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="Hero01">
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/all.css" rel="stylesheet" />
  </Fragment>
  {/* A full-height hero with a header and centered content layered over the background. */}
  <Stack isContainer pos="relative" min-h="100svh" c="white" ff="'Gen Interface JP', 'Hiragino Sans', sans-serif">
    {/* 背景画像と暗いオーバーレイ */}
    <Frame isLayer>
      <Media isLayer src="https://cdn.lism-css.com/img/BObC4emORTNt.webp" alt="" width="960" height="640" style={{ objectPosition: '40% center' }} />
      <Layer bgc="black:50%" style={{ backdropFilter: 'blur(4px)' }} />
    </Frame>
    {/* Header */}
    <Container as="header" isWrapper="xl" hasGutter py="25" t="0" z="2">
      <Flex ai="center" jc="between" g="30">
        <Inline lts="l" tt="upper">Lism Resort</Inline>
        <Flex as="nav" ai="center" g="30" fz="s" fw="light" d={['none', null, 'flex']}>
          <Link href="#" set="plain" hasTransition hov="-o">Rooms</Link>
          <Link href="#" set="plain" hasTransition hov="-o">Packages</Link>
          <Link href="#" set="plain" hasTransition hov="-o">Access</Link>
        </Flex>
        <Flex ai="center" d={['flex', null, 'none']}>
          <Icon icon="menu" fz="2xl" label="Open the menu" />
        </Flex>
      </Flex>
    </Container>
    {/* 中央に重ねるコンテンツ */}
    <Container isWrapper="s" hasGutter my="auto" py="50" z="1">
      <Stack ai="center" g="40">
        <Stack ai="center" g="40">
          <Heading level="1" class="u--trim" fz={['3xl', '4xl']} lh="s" fw="100" ta="center">A quiet retreat<br />between sea and sky</Heading>
          <Text class="u--trim" fz="s" lh="l" fw="light" ta="center">
            Wake up to the sound of the waves and watch the sun sink into the horizon.<br />A small retreat made for doing nothing at all.
          </Text>
        </Stack>
        <Flex g="20 30" fxw="wrap" jc="center">
          <Button href="#" variant="outline" c="white" bdrs="99" px="35" py="10" hasTransition hov={{ bgc: 'base', c: 'text' }}> View rooms </Button>
        </Flex>
      </Stack>
    </Container>
  </Stack>
</DemoLayout>
