---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Columns, Cluster, Divider, Flex, Group, Heading, Inline, Stack, Text, Wrapper } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="Hero002">
  <Group as="section" className="c--workHero" isContainer hasGutter bgc="green:10%">
    <Wrapper contentSize="xl" py={['40', null, '50']}>
      <Columns cols={[1, null, 2]} g={['40', null, '50']} ai="center">
        <Stack g="40">
          <Cluster g="10">
            <Inline bgc="green" c="white" fz="2xs" fw="bold" lts="l" px="15" py="5" bdrs="99">チームのための仕事管理</Inline>
            <Inline fz="xs" c="text-2">新しいチームプランが登場</Inline>
          </Cluster>
          <Stack g="25">
            <Heading level="1" className="u--trim" fz={['2xl', null, '4xl']} fw="bold" hl="xs">
              仕事の今が、<br />ひと目でわかる。
            </Heading>
            <Text className="u--trim" fz="m" hl="l" c="text-2" max-sz="m">
              タスク、会話、決定事項をプロジェクトごとに整理。次にやることが自然と見えて、チームのリズムが整います。
            </Text>
          </Stack>
          <Cluster g="15">
            <Button href="#" bgc="text" c="base" px="30" py="15" bdrs="99" fw="bold">無料ではじめる</Button>
            <Button href="#" variant="outline" keycolor="text" px="30" py="15" bdrs="99" fw="bold">活用例を見る</Button>
          </Cluster>
          <Text fz="xs" c="text-2">14日間無料・クレジットカード不要</Text>
        </Stack>

        <Stack bgc="base" bdrs="30" bxsh="20" bd bdc="divider" ov="hidden">
          <Flex jc="between" ai="center" p="25" bd-be bdc="divider">
            <Stack g="5">
              <Inline fz="2xs" c="text-2" lts="l">PROJECT</Inline>
              <Inline fw="bold">Webサイトリニューアル</Inline>
            </Stack>
            <Inline bgc="green:20%" c="green" fz="2xs" fw="bold" px="15" py="5" bdrs="99">順調</Inline>
          </Flex>
          <Stack g="30" p={['25', null, '35']}>
            <Columns cols={3} g="10">
              <Stack g="5" bgc="base-2" p="15" bdrs="20">
                <Inline fz="2xs" c="text-2">進行中</Inline>
                <Inline fz="2xl" fw="bold">8</Inline>
              </Stack>
              <Stack g="5" bgc="green:10%" p="15" bdrs="20">
                <Inline fz="2xs" c="text-2">完了</Inline>
                <Inline fz="2xl" fw="bold" c="green">24</Inline>
              </Stack>
              <Stack g="5" bgc="orange:10%" p="15" bdrs="20">
                <Inline fz="2xs" c="text-2">確認待ち</Inline>
                <Inline fz="2xl" fw="bold" c="orange">3</Inline>
              </Stack>
            </Columns>
            <Stack g="15">
              <Flex jc="between" ai="center">
                <Inline fw="bold">今週のタスク</Inline>
                <Inline fz="2xs" c="text-2">5月20日 — 24日</Inline>
              </Flex>
              <Divider />
              <Flex jc="between" ai="center" g="20">
                <Cluster g="10">
                  <Inline aria-hidden="true" d="block" p="5" bgc="green" bdrs="99" />
                  <Text fz="s">トップページの構成を確定</Text>
                </Cluster>
                <Inline fz="2xs" c="text-2">今日</Inline>
              </Flex>
              <Flex jc="between" ai="center" g="20">
                <Cluster g="10">
                  <Inline aria-hidden="true" d="block" p="5" bgc="orange" bdrs="99" />
                  <Text fz="s">撮影素材のセレクト</Text>
                </Cluster>
                <Inline fz="2xs" c="text-2">明日</Inline>
              </Flex>
              <Flex jc="between" ai="center" g="20">
                <Cluster g="10">
                  <Inline aria-hidden="true" d="block" p="5" bgc="blue" bdrs="99" />
                  <Text fz="s">開発チームへ引き継ぎ</Text>
                </Cluster>
                <Inline fz="2xs" c="text-2">金曜</Inline>
              </Flex>
            </Stack>
          </Stack>
        </Stack>
      </Columns>
    </Wrapper>
  </Group>
</DemoLayout>
