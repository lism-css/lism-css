---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Container, Frame, Heading, Inline, Media, Stack, Text, WithSide } from 'lism-css/astro';
---

<DemoLayout title="Testimonials003">
  <Container as="section" isWrapper="l" hasGutter bgc="base-2" py="50">
    <WithSide g="40 50" ai="center" sideW="xs" mainW="xs">
      <Frame isSide as="figure" ar="1/1" bdrs="40">
        <Media src="/img/avatar04.jpg" alt="導入企業の担当者、佐藤美咲さん" width="1024" height="1024" />
      </Frame>

      <Stack g="30">
        <Heading level="2" class="u--trim" fz="xl" fw="bold">ご利用者の声</Heading>
        <Text as="blockquote" set="plain" class="u--trim" fz="xl" hl="l">
          「相談の時間が増えたことで、迷いを抱え込まずに進めるチームになりました。」
        </Text>
        <Stack g="10" bd-bs pbs="20">
          <Inline fw="bold">佐藤美咲</Inline>
          <Inline fz="s" c="text-2">株式会社ノースノート　プロジェクトマネージャー</Inline>
        </Stack>
      </Stack>
    </WithSide>
    <Text mbs="30" fz="xs" c="text-2">企業・人物・成果はサンプルです。</Text>
  </Container>
</DemoLayout>
