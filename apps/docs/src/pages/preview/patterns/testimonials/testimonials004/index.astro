---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Container, Heading, Inline, Stack, Text, WithSide } from 'lism-css/astro';
---

<DemoLayout title="Testimonials004">
  <Container as="section" isWrapper="l" hasGutter bgc="text" c="base" py="50">
    <WithSide g="40 50" ai="center" sideW="xs" mainW="xs">
      <Stack isSide g="30">
        <Stack g="10">
          <Inline fz="s" o="p">導入事例</Inline>
          <Heading level="2" class="u--trim" fz="xl">株式会社アオバ食品</Heading>
        </Stack>
        <Stack g="10" bd-bs bdc="accent" pbs="20">
          <Inline fz="4xl" fw="bold">42%</Inline>
          <Text fz="s" c="base">月次レポート作成時間を削減</Text>
        </Stack>
      </Stack>

      <Stack g="30">
        <Text as="blockquote" set="plain" class="u--trim" fz="l" hl="l">
          「数字を集める作業が減り、店舗ごとの改善策を話す時間に変わりました。導入初月から全員が同じ画面を見て判断できています。」
        </Text>
        <Stack g="10">
          <Inline fw="bold">高橋直樹</Inline>
          <Inline fz="s" c="base">経営企画部　マネージャー</Inline>
        </Stack>
      </Stack>
    </WithSide>
    <Text mbs="30" fz="xs" c="base" o="pp">企業・人物・成果はサンプルです。</Text>
  </Container>
</DemoLayout>
