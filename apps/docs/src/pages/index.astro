---
/**
 * トップページ
 * Lism CSSの紹介とドキュメントへの導線
 */
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import { Stack, Flex, Lism, Heading, Text, Columns, Box, Icon, Center, Media, Frame, Group } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { siteConfig } from '@/config/site';
// import LismExDemo from '@/content/ja/_demo/LismExDemo.mdx';

// Features
const features = [
  {
    title: 'レイアウトプリミティブ',
    desc: 'Stack, Flex, Grid, Columns など、よく使うレイアウトパターンをレイアウトプリミティブとして提供。組み合わせるだけでサイトの骨組みが完成します。',
    src: '/img/features-01.png',
    width: 250,
    height: 175,
    ar: '250/175',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'ハーモニックスケール',
    desc: '余白・フォントサイズ・行間を調和的な比率で設計。自然と心地よいリズムをデザインに生み出すタイポグラフィ設計です。',
    src: '/img/features-02.png',
    width: 250,
    height: 200,
    ar: '250/200',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'デザイントークン',
    desc: 'カラー・フォントサイズ・余白・角丸・シャドウなどを段階的なCSS変数で一元管理。サイト全体の一貫性を保ちます。',
    src: '/img/features-03.png',
    width: 200,
    height: 200,
    ar: '200/200',
    widthBase: '9.375rem',
    widthMd: '12.5rem',
  },
  {
    title: 'Property Class',
    desc: '-fz:l, -p:20 のような直感的なクラス名で素早くスタイリング可能。形式が明確で短縮記法なのにAIが迷いません。',
    src: '/img/features-04.png',
    width: 200,
    height: 200,
    ar: '200/200',
    widthBase: '10rem',
    widthMd: '12.5rem',
  },
  {
    title: 'CSSレイヤー構造',
    desc: '@layer による 厳格なCSSレイヤー設計。詳細度の衝突を防ぎ、拡張性と保守性を両立します。',
    src: '/img/features-05.png',
    width: 250,
    height: 192,
    ar: '250/192',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'レスポンシブ',
    desc: 'CSS変数とクラスを組み合わせた独自のレスポンシブ手法。軽量なのに柔軟で幅広いレイアウトに対応できます。',
    src: '/img/features-06.png',
    width: 248,
    height: 184,
    ar: '248/184',
    widthBase: '11.625rem',
    widthMd: '15.5rem',
  },
];

// 背景ストライプ
const stripes = Array.from({ length: 50 });

// AIツール連携
const tools = [
  {
    title: 'MCPサーバー',
    body: 'Claude CodeやCursor、VS Code等のAIコーディングツールにLism CSSの仕様を提供します。AIがLism CSSの最新ドキュメントやAPI情報をリアルタイムで参照しながらコーディングを支援するため、独自の命名規則に不安がある場合でも、正しいクラス名やProps指定をAIがガイドしてくれます。',
    src: '/img/ai-02.png',
    width: 288,
    height: 200,
  },
  {
    title: 'Skills',
    body: 'AIエージェント向けの実装ガイドスキルを用意しています。Lism CSS独自の命名規則や設計思想をAIが正しく理解することで、ベストプラクティスに従った正確なコードを生成できます。Claude Codeなど主要なAIコーディングツールに対応しています。',
    src: '/img/ai-03.png',
    width: 215,
    height: 200,
  },
];

// プリセット
const presets = [
  {
    src: '/img/preset-img-01.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-02.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-03.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-04.png',
    width: 408,
    height: 194,
  },
  {
    src: '/img/preset-img-05.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-06.png',
    width: 408,
    height: 228,
  },
  {
    src: '/img/preset-img-07.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-08.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-09.png',
    width: 408,
    height: 231,
  },
];
---

<SimpleLayout title={siteConfig.name} description={siteConfig.description} schemaType="HomePage" excludeFromSearch>
  {/* 背景動画：スクロールしても固定表示 */}
  <!-- <Box pos="fixed" i-x="0" t="0" h="100vh" z="-1" ov="hidden" aria-hidden="true" style={{ mixBlendMode: 'darken' }}>
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline>
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Flex pos="absolute" i="0" jc="center">
      {
        stripes.map(() => (
          <Box
            w="80px"
            h="100%"
            fxsh="0"
            bg="linear-gradient(270deg, rgba(255, 255, 255, 0.02) 0%, rgba(0, 0, 0, 0.30) 83.65%, rgba(255, 255, 255, 0.02) 100%)"
            style={{ mixBlendMode: 'overlay', backdropFilter: 'blur(90px)' }}
          />
        ))
      }
    </Flex>
  </Box> -->
  <Box pos="fixed" i-x="0" t="0" h="100vh" z="-1" ov="hidden" aria-hidden="true" style={{ mixBlendMode: 'darken' }}>
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline>
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Box pos="absolute" i="0" style={{ backdropFilter: 'blur(80px)' }} />
    <Box pos="absolute" i="0" style={{ mixBlendMode: 'overlay' }}>
      <Flex pos="absolute" i="0" jc="center">
        {
          stripes.map(() => (
            <Box
              w="64px"
              h="100%"
              fxsh="0"
              bd-l
              bdc="rgba(255, 255, 255, 0.05)"
              bg="linear-gradient(90deg, rgba(255, 255, 255, 0.30) 0%, rgba(34, 34, 34, 0.30) 60%, rgba(0, 0, 0, 0.30) 70%, rgba(34, 34, 34, 0.30) 80%, rgba(255, 255, 255, 0.30) 100%)"
            />
          ))
        }
      </Flex>
    </Box>
  </Box>
  <Lism as="section" isWrapper="l" px="20">
    <Stack as="div" ai="center" pbs={{ base: '9rem', md: '14rem' }} pbe={{ md: '60' }}>
      <Heading ta="center" level="1" fw="700" fz={{ base: '3xl', md: '5xl' }} lh="1.25" c="var(--gray-hi-c)" lts="-0.01em">
        The CSS Design <Lism as="br" d={{ base: 'inherit', md: 'none' }} />Framework<br />for AI and Humans
      </Heading>
      <Text class="c--line-height" fz={{ base: 's', md: 'l' }} c="#333" mt="30" style={{ '--lh--base': '1.5', '--lh--l': '1.75' }}>
        軽量でビルド不要。どのサイトにも導入できます。<br />
        あなたはもう、CSS設計に悩む必要はありません。
      </Text>
      <Flex g={{ base: '15', md: '20' }} ai="center" jc="center" mt="40" w="100%">
        <Button href="/docs/installation" bdrs="var(--bdrs--15)" bd="none" bgc="var(--gray-hi-c)" fw="500" lh="1.5" px="10" g="0">
          <Lism as="span" px={{ base: '0.375rem', md: '10' }} fz={{ base: 's', md: 'base' }}>Get Started</Lism>
          <Icon icon="caret-right" size="16" style={{ scale: '1' }} />
        </Button>
        <Box pos="relative" max-w={{ base: '11.5625rem', md: '16.6875rem' }} w="100%" bd="none">
          <input id="kv-search" class="c--kv-search c--shadow-box" type="text" placeholder="Search documentation..." autocomplete="off" />
          <Lism
            as="button"
            type="button"
            class="c--searchTrigger"
            px="10"
            py="0.125rem"
            h="fit-content"
            bd="none"
            bgc="transparent"
            g="5"
            bdrs="10"
            pos="absolute"
            r="10"
            i-y="0"
            d={{ base: 'none', md: 'flex' }}
            hov={{ bgc: 'base-2' }}
            data-modal-open="search-modal"
          >
            <Lism as="kbd" class="c--searchTrigger_shortcut" p="0" bxsh="none" bd="none" fz="base" ff="base" lh="1.25" lts="-0.02em">⌘K</Lism>
          </Lism>
        </Box>
      </Flex>
      {/* TODO: AIコード生成のイメージ図。フロント確認のため画像で配置。実装方法変更予定 */}
      <Group bxsh="var(--bxsh--code)" bdrs="0.625rem" mbs={{ base: '40', md: '3.5rem' }}>
        <Media src="/svg/code-pc.svg" alt="" width="903" height="400" d={{ base: 'none', md: 'block' }} />
        <Media src="/svg/code-sp.svg" alt="" width="368" height="552" d={{ base: 'block', md: 'none' }} />
      </Group>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Features</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">洗練された設計理論</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="52.5rem">
        Lism
        CSSは、Webサイトの構造的な基盤を素早くスムーズに構築するための軽量CSSフレームワークです。自然で心地よいリズムがデザインに生まれるよう、CSSアーキテクチャをゼロから設計しました。
      </Text>

      <Columns cols={{ base: 1, md: 2, lg: 3 }} g="10" mbs={{ base: '50', md: '60' }}>
        {
          features.map((card) => (
            <Stack class="c--shadow-box" p="40">
              <Text fw="700" lh="1.5" c="var(--gray-hi-c)" lts="-0.01em" fz={{ base: 'base', md: '1.5rem' }}>
                {card.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" fxg="1">
                {card.desc}
              </Text>
              <Media
                src={card.src}
                alt=""
                width={card.width}
                height={card.height}
                mx="auto"
                mt="50"
                ar={card.ar}
                w={{ base: card.widthBase, md: card.widthMd }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter pos="relative">
    {/* AIツール連携セクション背景画像 */}
    <Group
      pos="absolute"
      w={{ base: '121.875rem', md: '162.5rem' }}
      l="50%"
      t="clamp(-2.625rem, calc(-2rem - 1.25vw), -2rem)"
      ms={{ base: '-60.9375rem', md: '-81.25rem' }}
      z="-1"
      max-w="none"
      aria-hidden="true"
    >
      <Media src="/img/ai-bg.png" alt="" width="2600" height="1559" w="100%" h="auto" />
    </Group>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Artificial Intelligence</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">AI ツール連携</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="52.5rem">
        Lism CSSはAIエージェントとの親和性を重視して設計されています。MCPサーバーとSkills、そして機械可読なドキュメントを提供することで、 Claude
        CodeやCursorなどのAIツールがLismの体系を正確に把握し、意図通りのコードを生成できます。
      </Text>
      <Frame mt="50" w={{ base: '18.375rem', md: '24.5625rem' }}>
        <Media src="/img/ai-01.png" alt="" width="393" height="240" />
      </Frame>
      <Columns cols={{ base: 1, md: 2 }} g="10" w="100%" mt="50">
        {
          tools.map((item) => (
            <Stack class="c--shadow-box" p="40">
              <Text c="var(--gray-hi-c)" fw="700" fz={{ base: 'base', md: '1.5rem' }} lh="1.5" lts="-0.01em">
                {item.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" max-w={{ base: '100%', md: '24rem' }} fxg="1">
                {item.body}
              </Text>
              <Media
                src={item.src}
                alt=""
                width={item.width}
                height={item.height}
                mbs={{ base: '50', md: '35' }}
                ms="auto"
                me={{ base: 'auto', md: '0' }}
                w="auto"
                h={{ base: '9.375rem', md: '12.5rem' }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Templates</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '4xl' }} fw="700" lh="1.5" c="var(--gray-hi-c)" lts="-0.01em"
          >Lism CSS プリセット</Heading
        >
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'base' }} lh="1.75" max-w="35rem">
        デザインのベースとして活用することも、必要な部分だけをコピー&ペーストしてプロジェクトにすぐ洗練されたレイアウトを追加することも可能です。
      </Text>
      <Button href="#" bdrs="var(--bdrs--15)" bd="none" bgc="var(--gray-hi-c)" mt="40" fw="500" lh="1.5" px="10" g="0">
        <Lism as="span" px={{ base: '0.375rem', md: '10' }} fz={{ base: 's', md: 'base' }}>View More</Lism>
        <Icon icon="caret-right" size="16" style={{ scale: '1' }} />
      </Button>
      <Box
        mbs={{ base: '50', md: '60' }}
        style={{ columnCount: 3, columnGap: 'var(--s10)', marginInline: 'clamp(-6.375rem, calc(22.921vw - 12.106rem), 0rem)' }}
      >
        {
          presets.map((item) => (
            <Frame class="c--shadow-box" mbe={{ base: '5', md: '10' }}>
              <Media src={item.src} alt="" width={item.width} height={item.height} />
            </Frame>
          ))
        }
      </Box>
    </Stack>
  </Lism>

  {/* CTA */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" pt="10.625rem">
      <Center class="c--shadow-box" ai="center" w="100%" max-w="l" min-h="calc(100svh - 21.25rem)" px={{ base: '15', md: '40' }} py="40">
        <Stack ai="center" g="15">
          <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Get Started</Text>
          <Heading
            level="2"
            ta="center"
            fz={{ base: '2xl', md: '4xl' }}
            fw="700"
            lh="1.5"
            c="var(--gray-hi-c)"
            lts="-0.01em"
            style={{ fontFeatureSettings: '"palt" on' }}>Lism CSS、どこでも使える</Heading
          >
        </Stack>
        <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'base' }} lh="1.75" lts="-0.01em">
          ビルドプロセスもセットアップも不要。<br />Lism CSSは1つのCSSファイルを読み込むだけで導入できます。
        </Text>
        <Button href="/docs/installation" bdrs="var(--bdrs--15)" bd="none" bgc="var(--gray-hi-c)" mt="40" fw="500" lh="1.5" px="10" g="0">
          <Lism as="span" px={{ base: '6px', md: '10' }} fz={{ base: 's', md: 'base' }}>Get Started</Lism>
          <Icon icon="caret-right" size="16" style={{ scale: '1' }} />
        </Button>
      </Center>
    </Stack>
  </Lism>
</SimpleLayout>

<script>
  const kvSearch = document.getElementById('kv-search');
  kvSearch?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const query = (e.target as HTMLInputElement).value.trim();
    if (!query) return;
    document.querySelector<HTMLElement>('[data-modal-open="search-modal"]')?.click();
    setTimeout(() => {
      const pfInput = document.querySelector<HTMLInputElement>('#search input[type="text"]');
      if (pfInput) {
        pfInput.value = query;
        pfInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }, 50);
  });
</script>

<style>
  video {
    position: absolute;
    top: 0;
    width: 100%;
    height: 150vh;
    object-fit: cover;
  }

  .c--kv-search {
    padding: var(--s10);
    font-size: var(--fz--m);
    width: 100%;
    outline: none;
    border: none;
    line-height: 1.5;
  }
  .c--kv-search:hover {
    background-color: var(--base-2);
  }
  .c--kv-search:focus {
    border-color: var(--brand);
  }

  /* 検索トリガーボタン */
  .c--searchTrigger {
    /* Figma の Stroke: Inside 相当 */
    box-shadow: inset 0 0 0 1px #eee;
    background: #f6f6f6;
    align-self: center;
  }
</style>
