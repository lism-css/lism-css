---
/**
 * トップページ
 * Lism CSSの紹介とドキュメントへの導線
 */
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import { Stack, Lism, Inline, Heading, Text, Columns, Box, Icon, Center, Media, Frame, Group } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import KvEditor from '@/components/KvEditor/KvEditor.astro';
import { siteConfig } from '@/config/site';
// import LismExDemo from '@/content/ja/_demo/LismExDemo.mdx';

// Features
const features = [
  {
    title: 'レイアウトプリミティブ',
    desc: 'Stack, Flex, Grid, Columns など、よく使うレイアウトパターンをレイアウトプリミティブとして提供。組み合わせるだけでサイトの骨組みが完成します。',
    src: '/img/features-layout.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'ハーモニックスケール',
    desc: '余白・フォントサイズ・行間を調和的な比率で設計。自然と心地よいリズムをデザインに生み出すタイポグラフィ設計です。',
    src: '/img/features-scale.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'デザイントークン',
    desc: 'カラー・フォントサイズ・余白・角丸・シャドウなどを段階的なCSS変数で一元管理。サイト全体の一貫性を保ちます。',
    src: '/img/features-tokens.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Propertyクラス',
    desc: '-fz:l, -p:20 のような直感的なクラス名で素早くスタイリング可能。形式が明確で短縮記法なのにAIが迷いません。',
    src: '/img/features-props.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'CSSレイヤー構造',
    desc: '@layer による 厳格なCSSレイヤー設計。詳細度の衝突を防ぎ、拡張性と保守性を両立します。',
    src: '/img/features-layer.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'レスポンシブ',
    desc: 'CSS変数とクラスを組み合わせた独自のレスポンシブ手法。軽量なのに柔軟で幅広いレイアウトに対応できます。',
    src: '/img/features-responsive.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
];

// AIツール連携
const tools = [
  {
    title: 'MCPサーバー',
    body: 'Claude CodeやCursor、VS Code等のAIコーディングツールにLism CSSの仕様を提供します。AIがLism CSSの最新ドキュメントやAPI情報をリアルタイムで参照しながらコーディングを支援するため、独自の命名規則に不安がある場合でも、正しいクラス名やProps指定をAIがガイドしてくれます。',
    src: '/img/ai-02.png',
    width: 288,
    height: 200,
  },
  {
    title: 'Skills',
    body: 'AIエージェント向けの実装ガイドスキルを用意しています。Lism CSS独自の命名規則や設計思想をAIが正しく理解することで、ベストプラクティスに従った正確なコードを生成できます。Claude Codeなど主要なAIコーディングツールに対応しています。',
    src: '/img/ai-03.png',
    width: 215,
    height: 200,
  },
];

// プリセット
const presets = [
  {
    src: '/img/preset-img-01.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-02.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-03.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-04.png',
    width: 408,
    height: 194,
  },
  {
    src: '/img/preset-img-05.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-06.png',
    width: 408,
    height: 228,
  },
  {
    src: '/img/preset-img-07.png',
    width: 408,
    height: 231,
  },
  {
    src: '/img/preset-img-08.png',
    width: 408,
    height: 168,
  },
  {
    src: '/img/preset-img-09.png',
    width: 408,
    height: 231,
  },
];
---

<SimpleLayout title={siteConfig.name} description={siteConfig.description} schemaType="HomePage" excludeFromSearch>
  {/* 背景動画：スクロールしても固定表示 */}
  {/* inert: Firefoxではvideo要素がフォーカス可能なため、装飾用背景をタブ順から除外 */}
  <Box class="c--kvVideoBg" pos="fixed" i-x="0" t="0" z="-1" h="100vh" ov="hidden" bgc="base" inert aria-hidden="true">
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline>
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Box pos="absolute" i="0" style={{ backdropFilter: 'blur(80px)' }} />
    <Box class="c--kvStripes" pos="absolute" i="0" style={{ mixBlendMode: 'overlay' }} />
  </Box>
  <Lism as="section" isWrapper="l" px="20">
    {
      /* ヒーローはライブコードエディター（KvEditor）の描画結果。位置決め（上下padding）は
        エディター外なのでレスポンシブ可。色・行間は _kv-editor.scss の .c--kvEditorHero に集約 */
    }
    <Box pbs={{ base: '9rem', md: '14rem' }} pbe={{ md: '60' }}>
      <KvEditor />
    </Box>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Features</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">洗練された設計理論</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="48em">
        Lism
        CSSは、Webサイトの構造的な基盤を素早くスムーズに構築するための軽量CSSフレームワークです。自然で心地よいリズムがデザインに生まれるよう、CSSアーキテクチャをゼロから設計しました。
      </Text>

      <Columns cols={{ base: 1, md: 2, lg: 3 }} g="10" mbs={{ base: '50', md: '60' }}>
        {
          features.map((card) => (
            <Stack class="c--shadow-box" p="40">
              <Text fw="700" lh="1.5" c="var(--gray-hi-c)" lts="var(--lts--tight)" fz={{ base: 'base', md: '1.5rem' }}>
                {card.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" fxg="1">
                {card.desc}
              </Text>
              <Media
                src={card.src}
                alt=""
                width={card.width}
                height={card.height}
                mx="auto"
                mt="50"
                ar={card.ar}
                w={{ base: card.widthBase, md: card.widthMd }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter pos="relative" z="1">
    {/* AIツール連携セクション背景画像 */}
    <Group
      class="c--ai-bg"
      pos="absolute"
      w={{ base: '121.875rem', md: '162.5rem' }}
      l="50%"
      t="clamp(-2.625rem, calc(-2rem - 1.25vw), -2rem)"
      ms={{ base: '-60.9375rem', md: '-81.25rem' }}
      z="-1"
      max-w="none"
      aria-hidden="true"
    >
      <Media src="/img/ai-bg.png" alt="" width="2600" height="1559" w="100%" h="auto" />
    </Group>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Artificial Intelligence</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '3rem' }} fw="700" lh="1.5" c="var(--gray-hi-c)">AI ツール連携</Heading>
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="48em">
        Lism CSSはAIエージェントとの親和性を重視して設計されています。MCPサーバーとSkills、そして機械可読なドキュメントを提供することで、 Claude
        CodeやCursorなどのAIツールがLismの体系を正確に把握し、意図通りのコードを生成できます。
      </Text>
      <Frame mt="50" w={{ base: '18.375rem', md: '24.5625rem' }}>
        <Media src="/img/ai-01.png" alt="" width="393" height="240" />
      </Frame>
      <Columns cols={{ base: 1, md: 2 }} g="10" w="100%" mt="50">
        {
          tools.map((item) => (
            <Stack class="c--shadow-box" p="40">
              <Text c="var(--gray-hi-c)" fw="700" fz={{ base: 'base', md: '1.5rem' }} lh="1.5" lts="var(--lts--tight)">
                {item.title}
              </Text>
              <Text fz={{ base: 's', md: 'base' }} lh="1.75" mt="20" max-w={{ base: '100%', md: '24rem' }} fxg="1">
                {item.body}
              </Text>
              <Media
                src={item.src}
                alt=""
                width={item.width}
                height={item.height}
                mbs={{ base: '50', md: '35' }}
                ms="auto"
                me={{ base: 'auto', md: '0' }}
                w="auto"
                h={{ base: '9.375rem', md: '12.5rem' }}
              />
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g="15">
        <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Templates</Text>
        <Heading level="2" ta="center" fz={{ base: '2xl', md: '4xl' }} fw="700" lh="1.5" c="var(--gray-hi-c)" lts="var(--lts--tight)"
          >Lism CSS テンプレート</Heading
        >
      </Stack>
      <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'l' }} lh="1.75" max-w="35em">
        デザインのベースとして活用することも、必要な部分だけをコピー&ペーストしてプロジェクトにすぐ洗練されたレイアウトを追加することも可能です。
      </Text>
      <Button
        href="/templates/"
        fz={{ base: 's', md: 'base' }}
        bdrs="var(--bdrs--15)"
        bd="none"
        bgc="var(--gray-hi-c)"
        hov={{ bgc: 'var(--link)' }}
        mt="40"
        fw="500"
        lh="1.5"
        px="10"
        g="0"
      >
        <Inline px={{ base: '0.375rem', md: '10' }}>View More</Inline>
        <Icon icon="caret-right" style={{ scale: '1' }} />
      </Button>
      <Box mbs={{ base: '50', md: '60' }} mx="clamp(-6.375rem, calc(22.921vw - 12.106rem), 0rem)" cg="10" style={{ columnCount: 3 }}>
        {
          presets.map((item) => (
            <Frame class="c--shadow-box" mbe={{ base: '5', md: '10' }}>
              <Media src={item.src} alt="" width={item.width} height={item.height} />
            </Frame>
          ))
        }
      </Box>
    </Stack>
  </Lism>

  {/* CTA */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" pt="10.625rem">
      <Center class="c--shadow-box" ai="center" w="100%" max-w="l" min-h="calc(100svh - 21.25rem)" px={{ base: '15', md: '40' }} py="40">
        <Stack ai="center" g="15">
          <Text c="var(--eyebrow-c)" tt="upper" lh="1" fz={{ base: 's', md: 'base' }}>Get Started</Text>
          <Heading
            level="2"
            ta="center"
            fz={{ base: '2xl', md: '4xl' }}
            fw="700"
            lh="1.5"
            c="var(--gray-hi-c)"
            lts="var(--lts--tight)"
            style={{ fontFeatureSettings: '"palt" on' }}>どこでも使える Lism CSS</Heading
          >
        </Stack>
        <Text ta="center" mbs={{ base: '20', md: '30' }} fz={{ base: 's', md: 'base' }} lh="1.75" lts="var(--lts--tight)">
          ビルドプロセスもセットアップも不要。<br />Lism CSSは1つのCSSファイルを読み込むだけで導入できます。
        </Text>
        <Button
          href="/docs/installation/"
          fz={{ base: 's', md: 'base' }}
          bdrs="var(--bdrs--15)"
          bd="none"
          bgc="var(--gray-hi-c)"
          hov={{ bgc: 'var(--link)' }}
          mt="40"
          fw="500"
          lh="1.5"
          px="10"
          g="0"
        >
          <Inline px={{ base: '6px', md: '10' }}>Get Started</Inline>
          <Icon icon="caret-right" style={{ scale: '1' }} />
        </Button>
      </Center>
    </Stack>
  </Lism>
</SimpleLayout>

<style>
  .c--kvVideoBg {
    mix-blend-mode: darken;

    :global([data-theme='dark']) & {
      mix-blend-mode: lighten;
    }
  }

  .c--kvStripes {
    background-image:
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 0.3) 0%,
        rgb(34 34 34 / 0.3) 60%,
        rgb(0 0 0 / 0.3) 70%,
        rgb(34 34 34 / 0.3) 80%,
        rgb(255 255 255 / 0.3) 100%
      );
    background-position: calc(50% + 32px) 0;
    background-repeat: repeat;
    background-size: 64px 100%;
  }

  video {
    position: absolute;
    top: 0;
    width: 100%;
    height: 150vh;
    object-fit: cover;

    :global([data-theme='dark']) & {
      filter: invert(1);
    }
  }

  .c--ai-bg {
    :global([data-theme='dark']) & {
      opacity: 0.2;
    }
  }
</style>
