---
/**
 * KVヒーロー + ライブコードエディター + AIデモパネル
 *
 * ヒーローエリア（.c--kvEditorHero）はエディターの描画結果そのもの。
 * 初期状態は SEO のためサーバーサイドでレンダリングし、
 * クライアントではエディターの編集・AIシナリオ再生に応じて innerHTML を書き換える。
 */
import { getRootLang, t, type LangCode } from '@/lib/i18n';
import { INITIAL_HTML_BY_LANG } from './initial-code';
import { highlight } from './lib/highlight';
import { STRINGS } from './lib/strings';

interface Props {
  /** 表示言語。省略時は root 言語（ja）。クライアント側へは data-kv-lang で受け渡す */
  lang?: LangCode;
}

// デモの提示モード。クライアント側へは data-kv-mode で受け渡す。
// - 'live': チャット演出なしの自動ループ再生（AIパネル非表示・エディター全幅・バーに ▶/⏸ トグル）
// - 'ai':   AIアシスタント風のチャットデモ（パネルのマークアップ・player.ts・シナリオ文言は温存
//           しているため、ここを戻すだけで復活する）
const DEMO_MODE: 'live' | 'ai' = 'live';
// const はリテラル型へ絞り込まれ、リテラル同士の比較が ts(2367) になるため union へ広げてから判定する
const isLiveMode = (DEMO_MODE as 'live' | 'ai') === 'live';

const { lang = getRootLang() } = Astro.props;
const initialHtml = INITIAL_HTML_BY_LANG[lang];
const kvEditorT = t(lang, 'kvEditor');

// エディターの初期表示もビルド時にハイライトしておく（表示フラッシュ防止）
const highlighted = await highlight(initialHtml, 'html');
---

<div class="c--kvEditorHero" data-kv-hero set:html={initialHtml} />

{
  /* 手書き風の "Edit Here!!" 誘導装飾（広い画面幅のみ表示）。エディターは overflow: hidden のため
     内側に置けず、この高さ 0 の行を基準にエディター右上へ絶対配置する（_kv-editor.scss） */
}
<span class="c--kvEditorEditHere" aria-hidden="true"></span>

<div class="c--kvEditor" data-kv-editor data-kv-lang={lang} data-kv-mode={DEMO_MODE}>
  <div class="c--kvEditor_window">
    <div class="c--kvEditor_bar">
      <span class="c--kvEditor_dots" aria-hidden="true"></span>
      <div class="c--kvEditor_tabs" role="tablist" aria-label={kvEditorT.tablistAriaLabel}>
        <button
          class="c--kvEditor_tab"
          type="button"
          role="tab"
          id="kv-tab-html"
          aria-selected="true"
          aria-controls="kv-editor-panel"
          data-kv-tab="html">HTML</button
        >
        {/* roving tabindex: 非選択タブはフォーカス順から外す（矢印キーで移動する） */}
        <button
          class="c--kvEditor_tab"
          type="button"
          role="tab"
          id="kv-tab-jsx"
          aria-selected="false"
          aria-controls="kv-editor-panel"
          tabindex="-1"
          data-kv-tab="jsx">JSX</button
        >
      </div>
      {
        isLiveMode && (
          /* ライブループ再生の「Live Demo ▶/⏸」トグル。自動で動き続けるデモの停止手段（WCAG 2.2.2）と、
             ホバーを持たないタッチデバイスの再開導線を兼ねる。ラベルは「勝手に動いている」ことの説明で、
             再生中はネオン風に発光する。アイコンは CSS（mask）で状態別に描画する。
             アクセシブルネームは aria-label が担うためラベルは aria-hidden（可視文言 "live demo" を含むので WCAG 2.5.3 も満たす） */
          <button class="c--kvEditor_playToggle" type="button" data-kv-loop-toggle data-kv-loop-state="paused" aria-label={STRINGS.playDemo}>
            <span class="c--kvEditor_playToggleLabel" aria-hidden="true">
              {STRINGS.liveDemo}
            </span>
            {/* アイコンは span 実要素。mask と drop-shadow を同一要素に掛けると filter → mask の順で
                影ごと切り抜かれるため、mask は ::before・グローの filter は span 本体に分離する */}
            <span class="c--kvEditor_playToggleIcon" aria-hidden="true" />
          </button>
        )
      }
    </div>
    {/* パネルは両タブで共有する 1 つの領域。aria-labelledby は switchTab がアクティブタブの id へ更新する */}
    <div class="c--kvEditor_editor" role="tabpanel" id="kv-editor-panel" aria-labelledby="kv-tab-html">
      {/* preInner は textarea のスクロールに transform で追従する（要素自体は差し替えない） */}
      <div class="c--kvEditor_pre" aria-hidden="true">
        {/* 反映フラッシュ（書き換えた行の背景をひと呼吸光らせる）。テキストの下に敷くため preInner より前に置く */}
        <span class="c--kvEditor_lineFlash" data-kv-line-flash></span>
        <div class="c--kvEditor_preInner" data-kv-pre-inner set:html={highlighted} />
      </div>
      <textarea
        class="c--kvEditor_input"
        id="kv-editor-input"
        data-kv-input
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        wrap="off"
        aria-label={kvEditorT.editorAriaLabel}
        aria-describedby="kv-editor-notices">{initialHtml}</textarea
      >
      {/* 通知スタック（上限超過・構文エラー・空提案）。子要素を縦に積み重ねて表示する */}
      <div class="c--kvEditor_snackbarStack" id="kv-editor-notices" data-kv-snackbar role="status"></div>
    </div>
  </div>
  {
    !isLiveMode && (
      <aside class="c--kvEditor_panel">
        <div class="c--kvEditor_placeholder" data-kv-placeholder>
          <span class="c--kvEditor_orb" aria-hidden="true" />
          <p class="c--kvEditor_placeholderText">Just ask. The code writes itself.</p>
        </div>
        <div class="c--kvEditor_messages" data-kv-messages />
        {/* SR向けの隠しライブリージョン。タイピング演出の途中経過は告知せず、確定した文言だけを player.ts が流し込む */}
        <p class="u--srOnly" data-kv-live aria-live="polite" />
        <button class="c--kvEditor_ask" type="button" data-kv-play aria-label="Ask AI to edit... (play the AI demo)">
          <span class="c--kvEditor_askText" data-kv-ask-text>
            Ask AI to edit...
          </span>
          <span class="c--kvEditor_askArrow" aria-hidden="true">
            <span>↑</span>
          </span>
        </button>
      </aside>
    )
  }
</div>

<script>
  import { initKvEditor } from './lib/editor';
  initKvEditor();
</script>
