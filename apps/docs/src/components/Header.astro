---
import { Flex, Cluster, Container, Icon, Lism, Group, Link } from 'lism-css/astro';
import { Modal } from '@lism-css/ui/astro/Modal';
import { siteConfig } from '@/config/site';
import SearchModal from './SearchModal.astro';
import SiteNav from './SiteNav.astro';
import SNSLinks from './SNSLinks.astro';
import LanguageSelect from './LanguageSelect.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { getLangFromUrl, getLocalizedUrl, t } from '@/lib/i18n';

// 現在の言語を取得
const currentLang = getLangFromUrl(Astro.url);
// サイトトップへのリンク（言語対応）
const homeUrl = getLocalizedUrl('/', currentLang);
// 翻訳テキスト
const searchText = t(currentLang, 'search');
// const headerText = t(currentLang, 'header');
---

<Container as="header" class="z--header" layout="flex" ai="center">
  {/* 全体のgridレイアウトの切り替えと、ハンバーガーボタンの表示タイミングがずれないように hasGutterは内側につける */}
  <Flex
    ai="center"
    w="100%"
    mx="auto"
    max-w="420px"
    p="20"
    bgc="white"
    bdrs="var(--bdrs--15)"
    bxsh="0 1px 4px 0 rgba(0, 0, 0, 0.03), 0 2px 16px 0 rgba(0, 0, 0, 0.05)"
    g="15"
    style={{ backdropFilter: 'blur(32px)' }}
    hasGutter
  >
    <Group me="auto">
      <Link href={homeUrl} class="siteTitle" layout="flex" ai="center" g="5" fw="normal" c="inherit" td="none">
        <img class="u--onlyLightMode" src="/logo-black.svg" alt="" aria-labelledby="site-logo-label" width="300" height="62" />
        <img class="u--onlyDarkMode" src="/logo-white.svg" alt="" aria-labelledby="site-logo-label" width="300" height="62" />
        <span id="site-logo-label" class="u--srOnly" translate="no">{siteConfig.name}</span>
      </Link>
    </Group>

    <Link href="/docs/" c="text" fw="500" lh="1.25" lts="-0.02em" td="none">Docs</Link>

    <SNSLinks d={['none', 'flex']} />

    <!-- 検索トリガーボタン -->
    <Lism
      as="button"
      type="button"
      class="c--searchTrigger l--flex -ai:center"
      px="10"
      py="5"
      g="5"
      bdrs="10"
      hov={{ bgc: 'base-2' }}
      aria-label={searchText.title}
      data-modal-open="search-modal"
    >
      <Icon icon="search" fz={['xl', null, 'l']} />
      <Lism
        as="kbd"
        class="c--searchTrigger_shortcut"
        d={['none', null, 'block']}
        p="0"
        bxsh="none"
        bd="none"
        fz="base"
        ff="base"
        lh="1.25"
        lts="-0.02em">⌘K</Lism
      >
    </Lism>

    <SearchModal />

    {/* ハンバーガーメニューボタン（モバイルのみ表示） */}
    <!-- <Modal.OpenBtn
      modalId="site-nav"
      class="c--menuTrigger l--center set--plain -bd -bdrs:10"
      d={['grid', null, 'none']}
      bgc="base"
      bdrs="10"
      hov={{ bgc: 'base-2' }}
      aria-labelledby="menu-open-label"
    >
      <Icon icon="menu" fz={['xl', null, 'l']} viewBox="0 0 256 256">
        <path
          d="M112,60a16,16,0,1,1,16,16A16,16,0,0,1,112,60Zm16,52a16,16,0,1,0,16,16A16,16,0,0,0,128,112Zm0,68a16,16,0,1,0,16,16A16,16,0,0,0,128,180Z"
        ></path>
      </Icon>
      <Inline d="none" id="menu-open-label">{headerText.openMenu}</Inline>
    </Modal.OpenBtn> -->
  </Flex>

  <Modal.Root id="site-nav" isContainer isWrapper="s" py="40" px="30">
    <Modal.Inner layout="stack" g="20" w="100%" max-h="100%" pos="relative" py="20" pbs="30" bdrs="20" bxsh="40">
      <Modal.CloseBtn modalId="site-nav" autofocus pos="absolute" t="0" r="0" z="1" fz="xl" p="10" m="15" bxsh="10" bdrs="10" bgc="base-2" />
      <Modal.Body layout="stack" g="40" px="30" pbs="40" ov-y="auto" z="0">
        <SiteNav />
      </Modal.Body>
      <Cluster g="10" fz="l" bd-t pbs="20" px="30">
        <SNSLinks />
        <LanguageSelect />
        <ThemeSwitch />
      </Cluster>
    </Modal.Inner>
  </Modal.Root>
</Container>
<style>
  /* logo */

  .siteTitle {
    font-family: var(--ff--mono);

    /* &::after {
      content: 'β';
      margin-inline-start: 0.5em;
      line-height: 1;
      font-size: var(--fz--s);
      letter-spacing: -0.125em;
      order: 2;
      padding: 1px;
      color: var(--brand);
    } */
  }
  .siteTitle > img {
    width: clamp(6rem, 15vw, 7.1875rem);
    height: auto;
  }

  /* 検索トリガーボタン */

  .c--menuTrigger {
    padding: 0.5em;
  }
  .c--searchTrigger {
    background: transparent;
    border: none;

    .a--icon {
      font-size: 20px;
    }

    @container (min-width: 800px) {
      & {
        border: 1px solid #eee;
        background: #f6f6f6;
      }
      .a--icon {
        font-size: 16px;
      }
    }
  }

  .c--searchTrigger_shortcut {
    /* box-shadow: none; */
    /* translate: unset; */
    /* margin-inline-end: 2px; */
  }
</style>
