---
import { Frame, BoxLink, Lism } from 'lism-css/astro';

/** サムネイル＋タイトルのカードリンク。patterns / page-layouts の一覧で共用 */
interface Props {
  href: string;
  thumbSrc: string;
  title: string;
  draft?: boolean;
  thumbRatio?: '3/2' | 'auto';
  thumbFit?: 'cover' | 'contain';
  [key: string]: unknown;
}

const { href, thumbSrc, title, draft = false, thumbRatio = '3/2', thumbFit = 'cover', ...props } = Astro.props as Props;
---

<BoxLink class={draft ? 'c--patternCard _draft' : 'c--patternCard'} layout="stack" href={href} g="15" set="hov" {...props}>
  <Frame ar={thumbRatio} bd bdrs="10">
    <Lism
      as="img"
      src={thumbSrc}
      alt={title}
      loading="lazy"
      decoding="async"
      class="c--patternCard_thumb"
      h={thumbRatio === 'auto' ? 'auto' : undefined}
      style={{ objectFit: thumbFit }}
      data-fit={thumbFit}
    />
  </Frame>
  <Lism class="u--trim -ff:mono -fz:2xs -c:text-2 -px:5" pb="10">
    {title}
  </Lism>
</BoxLink>

<style>
  @layer lism-custom {
    .c--patternCard > .l--frame {
      /* --bdw: 2px; */
      transition: box-shadow 0.2s;
      box-shadow: var(--_isHov, var(--bxsh--30)) var(--_notHov, var(--bxsh--0));
    }

    .c--patternCard_thumb {
      object-position: top;
      transition: transform 0.3s ease;
    }

    .c--patternCard:hover .c--patternCard_thumb[data-fit='cover'] {
      transform: scale(1.02);
    }
  }
</style>
