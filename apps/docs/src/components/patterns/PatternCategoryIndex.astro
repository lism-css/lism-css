---
import { Stack, Cluster, Heading, Inline, Link } from 'lism-css/astro';
import PageHeader from '@parts/PageHeader.astro';
import PreviewFrame from '@/components/Preview/PreviewFrame.astro';
import { getPatternCategory, type PatternCategoryView } from '@/lib/patterns';
import { getLocalizedUrl, isRootLang, type LangCode } from '@/lib/i18n';

interface Props {
  lang: LangCode;
  categoryId: PatternCategoryView['id'];
}

const { lang, categoryId } = Astro.props as Props;
const category = getPatternCategory(categoryId, lang)!;
const items = category.items;

const copy = lang === 'ja' ? { details: '詳細を見る' } : { details: 'View details' };
---

<Stack g="40" class="c--patternPage">
  <PageHeader
    title={category.label}
    count={items.length}
    description={category.description[lang]}
    lang={lang}
    breadcrumbs={[
      { label: 'Patterns', href: getLocalizedUrl('/patterns/', lang) },
      { label: lang === 'ja' ? `${category.label}一覧` : category.label },
    ]}
  >
    {
      category.related && (
        <Cluster g="15" fz="xs">
          {category.related.map((related) => (
            <Link href={getLocalizedUrl(related.path, lang)}>{related.label}</Link>
          ))}
        </Cluster>
      )
    }
  </PageHeader>

  <Stack g="50">
    {
      items.map((item, index) => (
        <Stack as="section" g="20">
          <PreviewFrame
            url={`/preview/patterns/${item.categoryId}/${item.id}/${isRootLang(lang) ? '' : `${lang}/`}`}
            title={item.title}
            hasSizeSwitch
            hasExternalLink={false}
            loading={index === 0 ? 'eager' : 'lazy'}
          >
            <Cluster slot="toolbar-start" g="15">
              <Heading level="2" fz="xl">
                {item.title}
              </Heading>
              {item.draft && (
                <Inline px="10" fz="2xs" ff="mono" bgc="text-2" c="base" bdrs="99">
                  draft
                </Inline>
              )}
            </Cluster>
            <Link slot="toolbar-end" href={getLocalizedUrl(`/patterns/${item.categoryId}/${item.id}/`, lang)} fz="s" w="fit">
              {copy.details} →
            </Link>
          </PreviewFrame>
        </Stack>
      ))
    }
  </Stack>
</Stack>
