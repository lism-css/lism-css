---
import { Stack, Flex, Box, Text, Inline, Heading, Cluster, Link } from 'lism-css/astro';
import { patterns, categoryIds, type PatternCategory, type PatternCategoryId } from '@/config/patterns';
import { filterDraftItems } from '@/lib/patterns';
import { getLocalizedUrl, type LangCode } from '@/lib/i18n';
import PatternCard from './PatternCard.astro';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;
const isJa = lang === 'ja';

const copy = isJa
  ? {
      title: 'Web Patterns',
      lead: 'コピペで簡単に利用できる、Lism CSSを使ったWebサイトパターン集です。',
      viewAll: 'すべて見る',
    }
  : {
      title: 'Web Patterns',
      lead: 'A collection of copy-and-paste ready web site patterns built with Lism CSS.',
      viewAll: 'View all',
    };
---

<Stack g="40">
  <Stack as="header" g="20">
    <h1>{copy.title}</h1>
    <Text c="text-2">{copy.lead}</Text>
  </Stack>

  <Stack g="40">
    {
      categoryIds.map((categoryId: PatternCategoryId) => {
        const category: PatternCategory = patterns[categoryId];
        const items = filterDraftItems(category.items);
        const categoryUrl = getLocalizedUrl(`/patterns/${categoryId}/`, lang);
        return (
          /* idは外部から /patterns/#{category} で参照されても飛べるように残す */
          <Box as="section" id={categoryId}>
            <Cluster ai="center" jc="space-between" g="15" bd-b py="10" px="5">
              <Flex ai="center" g="10">
                <Heading level="2" fz="xl">
                  <Link href={categoryUrl} set="plain">
                    {category.label}
                  </Link>
                </Heading>
                <Inline fz="xs" c="text-2" fw="normal" fxsh="0">
                  ({items.length})
                </Inline>
              </Flex>
              <Link href={categoryUrl} fz="xs" fxsh="0">
                {copy.viewAll} →
              </Link>
            </Cluster>

            <Stack g="5" mbs="15" px="5">
              <Text fz="xs" c="text-2">
                {category.description[lang]}
              </Text>
              {category.related && (
                <Cluster g="15" fz="xs">
                  {category.related.map((related) => (
                    <Link href={getLocalizedUrl(related.path, lang)}>{related.label}</Link>
                  ))}
                </Cluster>
              )}
            </Stack>

            <Flex hasSnap ov="auto" g="20" mbs="20" px="5" py="15" class="c--patternReel">
              {items.map((item) => (
                <PatternCard lang={lang} categoryId={categoryId} item={item} fxsh="0" w="20rem" max-sz="85%" />
              ))}
            </Flex>
          </Box>
        );
      })
    }
  </Stack>
</Stack>

<style>
  .c--patternReel {
    scroll-padding-inline: var(--s5);
  }
</style>
