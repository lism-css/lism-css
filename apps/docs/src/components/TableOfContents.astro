---
import type { TocItem } from '../lib/generateToc';
import TocItemComponent from './TocItem.astro';
import { Stack, Heading } from 'lism-css/astro';
import { getLangFromUrl, t } from '@/lib/i18n';
import type { Responsive } from 'lism-css/lib/types/ResponsiveProps';

interface Props {
  toc: TocItem[];
  px?: Responsive<string | number>;
  py?: Responsive<string | number>;
}

const { toc, px, py } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const tocText = t(lang, 'toc');
---

<Stack as="nav" class="c--toc" g="15" px={px} py={py} aria-label={tocText.ariaLabel}>
  <Heading level="3" class="b--eyebrow" tt="upper">{tocText.title}</Heading>
  <Stack as="ul" class="c--toc_list" g="0" bd-s>
    {toc.map((item) => <TocItemComponent item={item} />)}
  </Stack>
</Stack>

<style is:global>
  /* 入れ子 (h3) はさらに少し小さく */
  .c--toc_list {
    ul a > span {
      font-size: 0.975em;
    }

    [data-nested] {
      padding-inline-start: calc(var(--nestedDepth, 0) * var(--s20));
    }
  }
</style>

<script>
  // スクロール位置に応じて目次のアクティブ状態を更新する
  function initTocHighlight() {
    // FixedToc とデスクトップ TOC で script が二重になるため、前回分を片付けてから初期化する
    const w = window as Window & { __tocHighlightCleanup?: () => void };
    w.__tocHighlightCleanup?.();

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (tocLinks.length === 0) return;

    // 見出しを id で一意化（デスクトップ TOC と FixedToc で二重に存在する）
    const headingById = new Map<string, HTMLElement>();
    tocLinks.forEach((link) => {
      const slug = link.dataset.tocLink;
      if (!slug || headingById.has(slug)) return;
      const heading = document.getElementById(slug);
      if (heading) headingById.set(slug, heading);
    });

    const headingIds = [...headingById.keys()];
    if (headingIds.length === 0) return;

    const mainScrollEl = document.querySelector<HTMLElement>('.c--siteMain_inner');

    function setActiveLink(slug: string) {
      tocLinks.forEach((link) => {
        link.classList.toggle('_active', link.dataset.tocLink === slug);
      });
    }

    function getScrollPadding() {
      if (!mainScrollEl) return 0;
      return parseFloat(getComputedStyle(mainScrollEl).scrollPaddingTop) || 0;
    }

    // スクロール位置から「いまの見出し」を決める（常に1つ選ぶ）
    function syncActiveFromScroll() {
      const pad = getScrollPadding();
      const rootTop = mainScrollEl?.getBoundingClientRect().top ?? 0;
      let current = headingIds[0];

      for (const id of headingIds) {
        const el = headingById.get(id)!;
        if (el.getBoundingClientRect().top <= rootTop + pad + 1) {
          current = id;
        } else {
          break;
        }
      }

      setActiveLink(current);
    }

    // ハッシュ先へ main スクロール領域内をスクロール（リロード時にブラウザ任せだとずれる／動かないことがある）
    function scrollMainToHash() {
      const hash = decodeURIComponent(location.hash.slice(1));
      if (!hash || !mainScrollEl) return false;

      const el = headingById.get(hash) ?? document.getElementById(hash);
      if (!el || !mainScrollEl.contains(el)) return false;

      const pad = getScrollPadding();
      const nextTop = mainScrollEl.scrollTop + (el.getBoundingClientRect().top - mainScrollEl.getBoundingClientRect().top) - pad;
      mainScrollEl.scrollTo({ top: Math.max(0, nextTop), behavior: 'instant' });
      return true;
    }

    // ハッシュなしなのに padding 分だけスクロールされている誤着地を戻す
    function correctSpuriousTopScroll() {
      if (location.hash || !mainScrollEl) return;
      const pad = getScrollPadding();
      if (pad > 0 && mainScrollEl.scrollTop > 0 && mainScrollEl.scrollTop <= pad + 1) {
        mainScrollEl.scrollTop = 0;
      }
    }

    function onHashChange() {
      scrollMainToHash();
      syncActiveFromScroll();
    }

    correctSpuriousTopScroll();
    scrollMainToHash();
    syncActiveFromScroll();

    mainScrollEl?.addEventListener('scroll', syncActiveFromScroll, { passive: true });
    window.addEventListener('hashchange', onHashChange);

    w.__tocHighlightCleanup = () => {
      mainScrollEl?.removeEventListener('scroll', syncActiveFromScroll);
      window.removeEventListener('hashchange', onHashChange);
    };
  }

  // DOMContentLoaded で初期化
  document.addEventListener('DOMContentLoaded', initTocHighlight);
  // Astro のページ遷移後にも再初期化（View Transitions 対応）
  document.addEventListener('astro:page-load', initTocHighlight);
</script>
