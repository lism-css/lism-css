-->

<style>
  /* 旧スタイルはコメントアウトで退避
  .c--themeSwitch {
    cursor: pointer;
  }
  .c--themeSwitch_icon {
    display: none;
  }
  :global([data-theme='light']) .c--themeSwitch_icon.-light {
    display: block;
  }
  :global([data-theme='dark']) .c--themeSwitch_icon.-dark {
    display: block;
  }
  */

  .c--themeModeSwitch_btn {
    cursor: pointer;
    border-radius: 0.25rem;
  }
  :global(html[data-theme-mode='system']) .c--themeModeSwitch_btn[data-theme-mode='system'],
  :global(html[data-theme-mode='light']) .c--themeModeSwitch_btn[data-theme-mode='light'],
  :global(html[data-theme-mode='dark']) .c--themeModeSwitch_btn[data-theme-mode='dark'] {
    background-color: #fff;
    color: var(--themeModeSwitch-btn);
  }
</style>

<script>
  /* 旧スクリプトはコメントアウトで退避
  document.querySelectorAll('.c--themeSwitch').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  });
  */

  document.querySelectorAll<HTMLButtonElement>('.c--themeModeSwitch_btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.themeMode!;
      const theme = mode === 'light' || mode === 'dark' ? mode : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-theme-mode', mode);
      localStorage.setItem('theme', mode);
    });
  });

  // システムモード選択中は、OS側のテーマ変更にリアルタイムで追従する
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (document.documentElement.getAttribute('data-theme-mode') !== 'system') return;
    document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
  });
</script>
