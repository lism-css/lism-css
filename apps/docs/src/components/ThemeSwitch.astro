        <clipPath id="clip0_5430_1751"><rect width="16" height="16" fill="white"></rect></clipPath>
      </defs>
    `,
  },
  {
    id: 'dark',
    label: themeSwitch.dark,
    iconPath: `
      <path d="M13.9999 8.52667C13.8951 9.66147 13.4692 10.7429 12.7721 11.6445C12.075 12.5461 11.1356 13.2305 10.0637 13.6177C8.99188 14.0049 7.83192 14.0787 6.7196 13.8307C5.60728 13.5827 4.5886 13.023 3.78275 12.2172C2.97691 11.4113 2.41723 10.3927 2.16921 9.28033C1.92118 8.16801 1.99508 7.00806 2.38224 5.9362C2.7694 4.86434 3.45382 3.92491 4.35541 3.22784C5.257 2.53076 6.33846 2.10487 7.47327 2C6.80888 2.89884 6.48917 4.0063 6.57229 5.12094C6.65541 6.23559 7.13584 7.28337 7.9262 8.07373C8.71656 8.86409 9.76435 9.34452 10.879 9.42764C11.9936 9.51077 13.1011 9.19106 13.9999 8.52667Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
    `,
  },
];
---

<Flex jc="center" ai="center" p="0.1875rem" bgc="var(--themeModeSwitch-bgc)" bdrs="var(--bdrs--15)" w="fit-content" class="c--themeModeSwitch">
  {
    themeModes.map((mode) => (
      <Lism
        as="button"
        type="button"
        p="0.375rem"
        h="1.75rem"
        bd="none"
        class="c--themeModeSwitch_btn"
        aria-label={mode.label}
        data-theme-mode={mode.id}
      >
        <Icon viewBox="0 0 16 16" size="var(--s20)" fill="none" d="block" set:html={mode.iconPath} />
      </Lism>
    ))
  }
</Flex>

