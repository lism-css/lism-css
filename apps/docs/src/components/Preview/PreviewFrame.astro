---
import { Stack, Frame, Icon } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { DesktopIcon, DeviceMobileCameraIcon, DeviceTabletCameraIcon } from '@phosphor-icons/react';
import { getLangFromUrl, t } from '@/lib/i18n';

/**
 * iframe プレビュー。
 * 高さは iframe 内の PreviewSizeReporter から通知される中身の高さにフィットさせ、
 * 上限は --ar（アスペクト比）から求めた高さ。上限を超える分は iframe 内でスクロールする。
 */
interface Props {
  [key: string]: any;
}
const { hasSizeSwitch = false, hasExternalLink = true, externalLinkLabel, url, ...props } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const externalLabel = externalLinkLabel ?? t(lang, 'demo').openNewTab;
---

<Stack g="20">
  {
    hasSizeSwitch && (
      <div class="c--previewSizeSwitcher l--flex -g:15 -jc:center" data-preview-url={url}>
        <button class="c--previewSizeSwitcher_btn l--center -bdrs:10" data-size="360px" data-w-pct="120" data-ar="2/3">
          <Icon as={DeviceMobileCameraIcon} fz="xl" />
        </button>
        <button class="c--previewSizeSwitcher_btn l--center -bdrs:10" data-size="600px" data-ar="3/4">
          <Icon as={DeviceTabletCameraIcon} fz="xl" />
        </button>
        <button class="c--previewSizeSwitcher_btn l--center -bdrs:10 _active" data-size="100%" data-ar="3/2">
          <Icon as={DesktopIcon} fz="xl" />
        </button>
      </div>
    )
  }

  <Frame id="preview-iframe" class="c--previewFrame" data-preview-url={url} bxsh="10" mx="auto" w="100%" max-w="100%" style={{ '--ar': '3/2' }}>
    {/* ar は高さ通知が届くまで（または JS 無効時）のフォールバック。通知後は iframe に height を直接指定する */}
    <Frame className="u--scalePreview" ar bdrs="20" bd bdw="3px" {...props}>
      <iframe src={url} width="800" height="600" style="border:0"></iframe>
    </Frame>
  </Frame>
  {
    hasExternalLink && (
      <Button href={url} variant="fill" target="_blank" rel="noopener noreferrer" bdrs="10" w="fit" mx="auto">
        {externalLabel}
      </Button>
    )
  }
</Stack>

<style>
  .c--previewSizeSwitcher_btn {
    padding: 8px;
    border: 1px solid #ccc;
    background: var(--base-2);
    cursor: pointer;
  }
  .c--previewSizeSwitcher_btn._active {
    background: var(--link) !important;
    color: white !important;
    border-color: var(--link) !important;
  }
</style>

<script>
  const SIZE_TYPE = 'lism-preview-size';
  const REQUEST_TYPE = 'lism-preview-size-request';

  // '3/2' → 1.5
  const parseRatio = (value: string): number => {
    const [w, h] = value.split('/').map((n) => parseFloat(n));
    return w > 0 && h > 0 ? w / h : 3 / 2;
  };

  document.querySelectorAll<HTMLElement>('.c--previewFrame').forEach((frame) => {
    const scaled = frame.querySelector<HTMLElement>('.u--scalePreview');
    const iframe = frame.querySelector('iframe');
    if (!scaled || !iframe) return;

    // iframe 内の CSS px で受け取る。zoom は .u--scalePreview 内で効くので、そのまま height に使える。
    let contentSize: { width: number; height: number } | null = null;

    const applyHeight = () => {
      if (!contentSize) return;
      const ratio = parseRatio(getComputedStyle(frame).getPropertyValue('--ar'));
      const maxHeight = contentSize.width / ratio;
      // 枠線ぶんで iframe が縮まないよう、高さは iframe 自体に指定し、Frame 側は比率を解除して中身に合わせる
      scaled.style.aspectRatio = 'auto';
      iframe.style.height = `${Math.min(contentSize.height, maxHeight)}px`;
    };

    window.addEventListener('message', (event) => {
      if (event.origin !== window.location.origin) return;
      if (event.source !== iframe.contentWindow || event.data?.type !== SIZE_TYPE) return;
      contentSize = { width: event.data.width, height: event.data.height };
      applyHeight();
    });

    // サイズ切替
    const url = frame.dataset.previewUrl ?? '';
    const switcher = document.querySelector(`.c--previewSizeSwitcher[data-preview-url="${url}"]`);
    if (!switcher) return;

    const buttons = switcher.querySelectorAll<HTMLElement>('.c--previewSizeSwitcher_btn');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        frame.style.width = button.dataset.size ?? '';
        frame.style.setProperty('--ar', button.dataset.ar ?? '');
        if (button.dataset.wPct) {
          scaled.style.setProperty('--w-pct', button.dataset.wPct);
        } else {
          scaled.style.removeProperty('--w-pct');
        }
        buttons.forEach((b) => b.classList.remove('_active'));
        button.classList.add('_active');

        // 幅・比率が変わったので、レイアウト後の値を iframe 側に問い合わせて高さを更新する
        iframe.contentWindow?.postMessage({ type: REQUEST_TYPE }, window.location.origin);
      });
    });
  });
</script>
