---
import { Lism } from 'lism-css/astro';
import { Tabs } from '@lism-css/ui/astro/Tabs';
interface Props {
  css?: string;
}
const { css, ...props } = Astro.props;

// カスタムCSSをプレビュー単位へ閉じ込める
const scopeId = css ? `demo-${Math.random().toString(36).slice(2, 9)}` : '';

const scopedCss = `.${scopeId}{ ${css} }`;
---

<Lism class:list={['c--preview', scopeId]} {...props}>
  <slot />
  {
    Astro.slots.has('tab') && (
      <Tabs.Root class="c--preview_code" variant="prev" g="15">
        <slot name="tab" />
      </Tabs.Root>
    )
  }
</Lism>
{scopedCss && <style set:html={scopedCss} />}

<style is:global>
  .b--tabs--prev .b--tabs_list {
    /* Memo: ov-x='auto' の時に margin がネガティブだと崩れるので、box-shadowで表現する。 */
    box-shadow: inset 0 -2px 0 var(--divider);
  }
  .b--tabs--prev .b--tabs_tab {
    --hl: var(--hl--s);
    font-size: var(--fz--s);
    padding-block: 0.5em;
    padding-inline: 0.875em;
    background-color: transparent;
    box-shadow: var(--_isSelected, inset 0 -2px 0 0 currentColor);
  }
</style>
