---
/**
 * テンプレートの機能リスト（✅ 付きの横並び）。カテゴリページと詳細ページで共用する。
 */
import { Cluster, Icon } from 'lism-css/astro';
import type { ComponentProps } from 'astro/types';

type ClusterProps = ComponentProps<typeof Cluster>;
type Props = ClusterProps & {
  features: string[];
};

const { features, ...rest } = Astro.props as Props;
---

<Cluster as="ul" g="5" cg="10" fz="s" hl="s" class="c--templateFeatures" {...rest}>
  {
    features.map((feat) => (
      <li class="-d:flex -ai:center -g:5 -c:text-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="a--icon -c:brand"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-check"
        >
          <path d="M20 6 9 17l-5-5" />
        </svg>
        {feat}
      </li>
    ))
  }
</Cluster>
