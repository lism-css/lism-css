---
import { Flex, Stack } from 'lism-css/astro';
import SiteNav from './SiteNav.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import LanguageSelect from './LanguageSelect.astro';
---

<Stack as="aside" class="c--siteSidebar" isContainer py="20" g="20" {...Astro.props}>
  <Stack class="c--siteSidebar_nav" ov-y="auto" fx="1" px="15">
    <SiteNav />
  </Stack>
  <Flex jc="between" g="5" bd-t px="15" pbs="20">
    <LanguageSelect />
    <ThemeSwitch />
  </Flex>
</Stack>

<script>
  // アクティブなナビリンクまでサイドバーをスクロール
  document.querySelector('.c--siteSidebar_nav .c--navLink._active')?.scrollIntoView({ block: 'center' });
</script>
