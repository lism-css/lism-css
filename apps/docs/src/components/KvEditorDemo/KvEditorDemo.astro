---
/**
 * KVヒーロー + ライブコードエディター + AIデモパネル
 *
 * ヒーローエリア（.c--kvHero）はエディターの描画結果そのもの。
 * 初期状態は SEO のためサーバーサイドでレンダリングし、
 * クライアントではエディターの編集・AIシナリオ再生に応じて innerHTML を書き換える。
 */
import { INITIAL_HTML } from './initial-code';
import { highlight } from './lib/highlight';

// エディターの初期表示もビルド時にハイライトしておく（表示フラッシュ防止）
const highlighted = await highlight(INITIAL_HTML, 'html');
---

<div class="c--kvHero" data-kv-hero set:html={INITIAL_HTML} />

<div class="c--kvDemo" data-kv-demo>
  <div class="c--kvDemo_window">
    <div class="c--kvDemo_bar">
      <span class="c--kvDemo_dots" aria-hidden="true"></span>
      <div class="c--kvDemo_tabs" role="tablist" aria-label="コード表記の切り替え">
        <button class="c--kvDemo_tab" type="button" role="tab" aria-selected="true" data-kv-tab="html">HTML</button>
        <button class="c--kvDemo_tab" type="button" role="tab" aria-selected="false" data-kv-tab="jsx">JSX</button>
      </div>
    </div>
    <div class="c--kvDemo_editor">
      {/* preInner は textarea のスクロールに transform で追従する（要素自体は差し替えない） */}
      <div class="c--kvDemo_pre" aria-hidden="true">
        <div class="c--kvDemo_preInner" data-kv-pre-inner set:html={highlighted} />
      </div>
      <textarea
        class="c--kvDemo_input"
        id="kv-editor-input"
        data-kv-input
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        wrap="off"
        aria-label="ライブコードエディター">{INITIAL_HTML}</textarea
      >
      {/* エラー通知（上限超過・構文エラー）。自動クローズ・非インタラクティブ */}
      <div class="c--kvDemo_snackbar" data-kv-snackbar role="status"></div>
    </div>
  </div>
  <aside class="c--kvDemo_panel">
    <div class="c--kvDemo_placeholder" data-kv-placeholder>
      <span class="c--kvDemo_orb" aria-hidden="true"></span>
      <p class="c--kvDemo_placeholderText">Just ask. The code writes itself.</p>
    </div>
    <div class="c--kvDemo_messages" data-kv-messages aria-live="polite"></div>
    <button class="c--kvDemo_ask" type="button" data-kv-play>
      <span class="c--kvDemo_askText" data-kv-ask-text>Ask AI to edit...</span>
      <span class="c--kvDemo_askArrow" aria-hidden="true"><span>↑</span></span>
    </button>
  </aside>
</div>

<script>
  import { initKvEditorDemo } from './lib/editor';
  initKvEditorDemo();
</script>
