---
/**
 * デモプレビュー用のシンプルなレイアウト
 * lism-cssのスタイルのみを読み込む。
 * iframeで埋め込まれることを想定したミニマルな構成
 */

// サイト設定
import { siteConfig } from '@/config/site';

import 'lism-css/scss/main.scss';
// index 経由だと他の Preview コンポーネントの CSS が先に入り @layer の宣言順が崩れるため、ファイルを直接読み込む
import PreviewSizeReporter from '@/components/Preview/PreviewSizeReporter.astro';

interface Props {
  title?: string;
}

const { title = 'Demo page' } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Demo | {title} - {siteConfig.name}</title>
    <!-- 検索エンジンにインデックスさせない -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <PreviewSizeReporter>
      <slot />
    </PreviewSizeReporter>
  </body>
</html>
